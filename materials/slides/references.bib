@article{acemoglu1999,
	title = {The structure of wages and investment in general training},
	volume = {107},
	issn = {00223808},
	doi = {10.1086/250071},
	abstract = {In the human capital model with perfect labor markets, firms never invest in general skills and all costs of general training are borne by workers. When labor market frictions compress the structure of wages, firms may pay for these investments. The distortion in the wage structure turns 'technologically' general skills into de facto 'specific' skills. Credit market imperfections are neither necessary nor sufficient for firm-sponsored training. Since labor market frictions and institutions shape the wage structure, they may have an important impact on the financing and amount of human capital investments and account for some international differences in training practices.},
