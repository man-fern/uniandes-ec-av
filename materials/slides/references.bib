	issn = {03629805},
	doi = {10.2307/440183},
	abstract = {This study evaluates the distributive politics theory. We analyze a pooled cross-section time series of data on the distribution of prime military contracts among the states during the period 1965-83. Unlike earlier studies, this one finds a significant relationship between representation on House and Senate defense committees and the distribution of military contracts.},
