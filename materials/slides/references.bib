}

@article{Shimer05,
	title = {The {Cyclical} {Behavior} of {Equilibrium} {Unemployment} and {Vacancies}},
	volume = {95},
	url = {https://ideas.repec.org/a/aea/aecrev/v95y2005i1p25-49.html},
	doi = {10.1257/0002828053828572},
	abstract = {This paper argues that the textbook search and matching model cannot generate the observed business-cycle-frequency fluctuations in unemployment and job vacancies in response to shocks of a plausible magnitude. In the United States, the standard deviation of the vacancy-unemployment ratio is almost 20 times as large as the standard deviation of average labor productivity, while the search model predicts that the two variables should have nearly the same volatility. A shock that changes average labor productivity primarily alters the present value of wages, generating only a small movement along a downward-sloping Beveridge curve (unemployment-vacancy locus). A shock to the separation rate generates a counterfactually positive correlation between unemployment and vacancies. In both cases, the model exhibits virtually no propagation.},
	number = {1},
	journal = {American Economic Review},
	author = {Shimer, Robert},
	year = {2005},
	pages = {25--49},
}

