	pages = {101--109},
}

@article{Kalt:1984,
	title = {Capture and {Ideology} in the {Economic} {Theory} of {Politics}},
	volume = {74},
	issn = {0002-8282},
	doi = {10.2307/1804008},
	abstract = {The economic theory of regulation long ago put public interest theories of politics to rest. These theories have correctly been viewed as normative wishings, rather than explanations of real world phenomena. They have been replaced by models of political behavior that are consistent with the rest of microeconomics. Recently, however, debate has arisen over whether some version of a public interest theory of regulation will have to be readmitted to people's thinking about actions and results in the political arena. This study assesses the nature and significance of publicly interested objectives in a particular instance of economic policymaking: the U.S. Senate voting on coal strip-mining regulations. The existence of such objectives is, of course, no contradiction of the economic view of human behavior. Generally, however, individuals' altruistic, publicly interested goals have been given little attention. This reflects the judgment that such goals are so empirically unimportant or well-founded apprehensions that they are unusually difficult to identify, measure, and analyze.},
	number = {3},
	journal = {The American Economic Review},
	author = {Kalt, Joseph and Zupan, Mark},
	year = {1984},
	keywords = {Contradiction, Economic system, Economics, Ideology, Legislature, Microeconomics, Normative, Politics, Public economics, Public interest, Public interest theory, Voting},
	pages = {279--300},
}

