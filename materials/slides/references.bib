@incollection{castillo1992minimum,
	title = {When the {Minimum} {Wage} {Really} {Bites} : {The} {Effect} of the {U} . {S} . -{Level} {Minimum} on {Puerto} {Rico}},
	isbn = {0-226-06633-9},
	abstract = {This paper has shown that the imposition of the U.S.-level minimum wage{\textbackslash}nto Puerto Rico distorted the Puerto Rican earnings distribution, substantially{\textbackslash}nreduced employment on the island, reallocated labor across industries, and{\textbackslash}naffected the characteristics of migrants to the United States. In addition, we{\textbackslash}nargued that, absent migration of the less skilled, imposition of a U.S.-level{\textbackslash}nminimum on the island would have raised unemployment so much as to call{\textbackslash}ninto question the viability of such a policy. Thus, migration was a prerequisite{\textbackslash}nfor the high minimum wage. Our estimates indicate further that migration was{\textbackslash}na major contributor to the growth of real earnings on the island. All told, the{\textbackslash}nmassive migration from Puerto Rico demonstrates both the interplay between{\textbackslash}ndomestic labor market policy-in this case, imposition of a minimum wage{\textbackslash}nwith a bite-and migration and the potential contribution of migration to the{\textbackslash}ngrowth of real wages in a source economy.},
	booktitle = {Immigration and the {Workforce}: {Economic} {Consequences} for the {United} {States} and {Source} {Areas}},
