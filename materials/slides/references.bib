@article{Francis:1982,
	title = {U. {S}. {State} {Legislative} {Committees}: {Structure}, {Procedural} {Efficiency}, and {Party} {Control}},
	volume = {7},
	issn = {03629805},
	doi = {10.2307/439350},
	abstract = {Through a nation-wide sample of state legislators, this analysis illustrates the extent to which committee systems in \{U.S.\} state legislatures have become the principal centers of decision making. In recent years the enormous demand for legislation has amplified the need for an efficient agenda-processing system, and increasingly the responsibility falls upon the committee system, which takes advantage of division of labor and economies of scale. There is a greater propensity to rely upon committees in chambers dominated by one party, and committee decision making tends to be less partisan. The extent to which the committee system can provide the necessary procedural efficiency will depend in part upon whether the specific organizing decisions take into account the size and partisan composition of the chamber.},
