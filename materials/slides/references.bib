@techreport{Keele:2004,
	title = {Difficult choices: an evaluation of heterogeneous choice models},
	isbn = {3-14-935727-6},
	abstract = {While the derivation and estimation of heterogeneous choice models appears straightforward, the properties of such models are not well understood. It is assumed that the properties of these models are identical to those of discrete choice models. We present analytical results that suggest the properties of these models are far more complex. Using a series of Monte Carlo experiments, we further analyze the properties of heteroskedastic probit and heteroskedastic ordered probit models. We test the relative efficiency of these models as well as how robust they are to specification and measurement error. We find that the estimates in heterogeneous choice models tend to be biased in all but ideal conditions and can often lead to incorrect inferences.},
