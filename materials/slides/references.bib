@article{Ordeshook:1970,
	title = {Extensions to a {Model} of the {Electoral} {Process} and {Implications} for the {Theory} of {Responsible} {Parties}},
	volume = {14},
	issn = {00263397},
	doi = {10.2307/2110392},
	abstract = {In this essay the candidates' incentives for advocating clear and distinct programs in two-party electoral systems are examined. The analysis focuses on a spatial model of the electoral process developed elsewhere with the assumptions that all citizens vote or that citizens abstain because of alienation. This model is extended to permit nonvoting from indifference. For a sufficiently general set of conditions it is proved that candidates provide less distinctive programs to the extent that citizens punish candidates (by not voting) for failing to provide distinct programs. Contrasting the candidates' incentives in single member and multi-member districts, moreover, both systems are shown to be theoretically imperfect from the perspective of the responsible party criteria, and that the incentives for distinct party programs are a function of the electorate's sense of citizen duty, as well as constitutional structure.},
	number = {1},
	journal = {Midwest Journal of Political Science},
	author = {Ordeshook, Peter C.},
	year = {1970},
	keywords = {comparative, partyid, theory, turnout},
	pages = {43},
}

@article{Nordhaus:1975,
	title = {The {Political} {Business} {Cycle}},
	volume = {42},
	issn = {00346527},
	doi = {10.2307/2296528},
	abstract = {There are many ways in which today's political choices affect future well-being. Future capital stocks, structures and machinery and roads, depend on the extent to which present generations invest instead of consume. Stocks of natural resources depend on past conservation efforts. There are perhaps more subtle ways in which we bequeath our tastes, consumption patterns, and folkways to the future and determine future welfare. Recently, economists have concluded that we also pass on the inflationary (or deflationary) con- sequences of current policies.},
	number = {2},
	journal = {The Review of Economic Studies},
	author = {Nordhaus, William D.},
	year = {1975},
	pages = {169},
}

@article{Herron:2002,
	title = {Electoral influences on legislative behavior in mixed-member systems: {Evidence} from {Ukraine}'s {Verkhovna} {Rada}},
	volume = {27},
	issn = {03629805},
	doi = {10.3162/036298002X200639},
	abstract = {This article addresses how mixed-member systems that combine proportional representation (PR) and single-member districts (SMD) into a single election can influence legislators' voting behavior. Scholars have generally extended standard expectations of behavior to mixed-member systems by assuming that legislators occupying PR seats in mixed-member parliaments should be more cohesive than those occupying SMD seats. I argue that controlling for seat type alone does not take into account the interaction between PR and SMD in mixed-member systems. Using voting data from Ukraine's Verkhovna Rada, I show that controlling for dual candidacy and the "safety" of the deputy's district or list position increases our understanding of the factors motivating legislative cohesion.},
	number = {3},
	journal = {Legislative Studies Quarterly},
	author = {Herron, Erik S.},
	year = {2002},
	pages = {361--382},
}

@article{Campbell:1982,
	title = {Cosponsoring {Legislation} in the {U}. {S}. {Congress}},
	volume = {7},
	issn = {03629805},
	doi = {10.2307/439366},
	abstract = {Since the mid-1930s in the Senate and the late-1960s in the House, members of Congress have been permitted to cosponsor legislation. Many members have become very active in cosponsoring legislation, while others have shown some reluctance. This article investigates several possible reasons for differing levels of cosponsorship activity. The goals of securing re-election, gaining influence within the Congress, and producing good public policy, as well as the member's general level of legislative activity, are examined as influences on cosponsorship activity. The findings indicate that the representative's cosponsorship activity is influenced by ideology (the representative's measure of good public policy), by the representative's general level of legislative activity, and by the representative's re-election prospects if in the Senate and seniority if in the House.},
	number = {3},
