@book{Morley95,
	title = {Poverty and {Inequality} in {Latin} {America}: {The} {Impact} of {Adjustment} and {Recovery} in the 1980s.},
	isbn = {978-0-8018-5064-6},
	abstract = {Examines the impact of adjustment on poverty and inequality in Latin America in the 1980s. Presents an overview of trends in macroeconomic variables in the main countries. Examines changes in the poverty level and distribution of income and relates them to changes in nonincome social indicators such as education and infant mortality. Discusses the progress made in the areas of education and health during the 1980s and describes the emergency employment programs that were enacted to provide jobs and maintain family incomes of the unemployed poor. Presents case studies of Argentina and Venezuela, in which poverty increased dramatically, and of Colombia and Costa Rica, in which it declined, highlighting those characteristics of economic structure, initial conditions, and government policy that appear to be related to differences in adjustment. Investigates the link between macroconditions, economic structure, and poverty using a broader sample of time-series evidence. Carries the story forward into the 1990s to examine both the effects of recovery in those countries where data is available and the effects of second-stage structural reforms in those countries that first adopted them. Morley is an advisor at the Inter-American Development Bank in Washington, D.C. Index},
	publisher = {The Johns Hopkins University Press},
	author = {Morley, Samuel A.},
	year = {1995},
	note = {Publication Title: The Johns Hopkins University Press},
}

@article{Psacharopoulos1995,
	title = {{POVERTY} {AND} {INCOME} {INEQUALITY} {IN} {LATIN} {AMERICA} {DURING} {THE} 1980s},
	volume = {41},
	issn = {14754991},
	doi = {10.1111/j.1475-4991.1995.tb00119.x},
	abstract = {On average, poverty and income inequality increased in Latin America during the 1980s. Forty‐six percent of the increase in poverty took place in the cities of Brazil alone, though part of this reflects the migration of poor rural inhabitants to urban areas. There is strong evidence that both income inequality and poverty mirrored the economic cycle, rising during recession and falling during recovery. Economies that grew (e.g. Colombia, Costa Rica) performed better with respect to poverty and income inequality than those that stagnated. In particular, countries that failed to stabilize effectively (e.g. Brazil, Peru) experienced substantial increases in poverty. Educational attainment has the greatest correlation with both income inequality and the probability of being poor. From a policy standpoint, there is a clear association between the provision of education, lessening of income inequality, and poverty reduction. Copyright © 1995, Wiley Blackwell. All rights reserved},
	number = {3},
	journal = {Review of Income and Wealth},
	author = {Psacharopoulos, George and Morley, Samuel and Fiszbein, Ariel and Lee, Haeduck and Wood, William C.},
	year = {1995},
}

