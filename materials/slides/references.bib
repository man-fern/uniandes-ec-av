@article{Zhangetal12,
	title = {Rational herding in microloan markets},
	volume = {58},
	issn = {00251909},
	doi = {10.1287/mnsc.1110.1459},
	abstract = {Microloan markets allow individual borrowers to raise funding from multiple individual lenders. We use a unique panel data set that tracks the funding dynamics of borrower listings on Prosper.com, the largest microloan market in the United States. We find evidence of rational herding among lenders. Well-funded borrower listings tend to attract more funding after we control for unobserved listing heterogeneity and payoff externalities. Moreover, instead of passively mimicking their peers (irrational herding), lenders engage in active observational learning (rational herding); they infer the creditworthiness of borrowers by observing peer lending decisions and use publicly observable borrower characteristics to moderate their inferences. Counterintuitively, obvious defects (e.g., poor credit grades) amplify a listing's herding momentum, as lenders infer superior creditworthiness to justify the herd. Similarly, favorable borrower characteristics (e.g., friend endorsements) weaken the herding effect, as lenders attribute herding to these observable merits. Follow-up analysis shows that rational herding beats irrational herding in predicting loan performance. ©2012 INFORMS.},
	number = {5},
	journal = {Management Science},
	author = {Zhang, Juanjuan and Liu, Peng},
	year = {2012},
	keywords = {Bayesian inference, Microloan markets, Observational learning, Peer-to-peer lending, Prosper.com, Rational herding},
	pages = {892--912},
}

