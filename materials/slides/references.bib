@article{Stigler:1973,
	title = {General {Economic} {Conditions} and {National} {Elections}},
	volume = {63},
	issn = {0002-8282},
	abstract = {This article evaluates the effect of economic conditions on electoral results in the United States. There is no difference between the Republicans and Democrats with respect to the ardent pursuit of high levels of employment and high and steady rates of growth of real income. Each party is so broadly constituted that quite aside from any loss of votes it is in the interest of each party's regular constituency to seed these goals. Prosperity is even more uncontroversial than motherhood now that overpopulation is feared. Nor do the parties differ in their intellectual or political resources to deal with macroeconomic policy. One should not infer that economic questions are unimportant to the policies of parties or to the various groups in the population who systematically support one of the parties. There are a host of distribution policies which are inescapably divisive: one cannot support both a rise and a fall in the share of income going to farmers, or the share of progressive taxes in the revenue system, or the share of income transferred to the poor. Inflation affects the distribution of income and we would therefore expect the rate of change of public policy. The rate of inflation was found to be negatively related to the incumbent's share of votes but this slight analysis is only suggestive. The economic bases for party affiliation must be sought in this area of income redistribution.},
	number = {2},
	journal = {American Economic Review},
	author = {Stigler, George J},
	year = {1973},
	keywords = {⛔ No DOI found},
	pages = {160--167},
}

