@article{Card1990,
	title = {The {Impact} of the {Mariel} {Boatlift} on the {Miami} {Labor} {Market}},
	volume = {43},
	issn = {00197939},
	doi = {10.2307/2523702},
	abstract = {Using data from the Current Population Survey, this paper describes the effect of the Mariel Boatlift of 1980 on the Miami labor market. The Mariel immigrants increased the Miami labor force by 7\%, and the percentage increase in labor supply to less-skilled occupations and industries was even greater because most of the immigrants were relatively unskilled. Nevertheless, the Mariel influx appears to have had virtually no effect on the wages or unemployment rates of less-skilled workers, even among Cubans who had immigrated earlier. The author suggests that the ability of Miami's labor market to rapidly absorb the Mariel immigrants was largely owing to its adjustment to other large waves of immigrants in the two decades before the Mariel Boatlift. (Abstract courtesy JSTOR.)},
	number = {2},
	journal = {Industrial and Labor Relations Review},
	author = {Card, David},
	year = {1990},
}

@article{TribinUribe2020,
	title = {Migración desde {Venezuela} en {Colombia}: {Caracterización} del fenómeno y análisis de los efectos macroeconómicos},
	issn = {0120-4483},
	doi = {10.32468/espe.97},
	abstract = {La crisis migratoria desde Venezuela es el éxodo más grande que se ha registrado en el hemisferio occidental en los últimos 50 años según la UNHCR (2020)[1]. Colombia es el país que ha presenciado el mayor choque de migración desde Venezuela en comparación al resto de países en América Latina y el Caribe. El aumento significativo de migrantes sugiere un choque poblacional en un lapso muy corto, que hace necesario entender los desafíos sobre el ajuste de la economía colombiana y sus efectos de corto y largo plazo. Este es un reporte exhaustivo que se centra en estudiar la migración desde Venezuela a Colombia y se divide en dos grandes módulos: en el primero, caracteriza el fenómeno migratorio y en el segundo discute las implicaciones del choque.},
	number = {97},
	journal = {Ensayos sobre Política Económica},
	author = {Tribín, Ana María and Adhvaryu, Achyuta and Anzola, Cesar and Ávila, Oscar and Bonilla, Leonardo and Castro, Juan Carlos and Flórez, Luz Adriana and Grajales, Ánderson and Guarín-López, Alexander and Hamann-Salcedo, Franz and Hermida-Giraldo, Didier and Khanna, Gaurav and Lasso-Valderrama, Francisco Javier and Medina-Durango, Carlos and Melo-Becerra, Ligia and Méndez, Juan Camilo and Morales, Leonardo and Nyshadam, Anant and Ospina, Juan José and Otero, Andrea and Pulido, José David and Ramos, Jorge and Ramos, Mario and Tamayo, Jorge and Velásquez, Santiago},
	year = {2020},
}

@article{Hoang2020,
	title = {Debt and (un)freedoms: {The} case of transnational labour migration from {Vietnam}},
	volume = {116},
	issn = {00167185},
	doi = {10.1016/j.geoforum.2020.08.001},
	abstract = {Transnational labour migration in Asia is largely organised by sophisticated networks of commercial brokers who thrive on highly restrictive migration regimes and disparities in the distribution of labour and employment across the region. The commercialisation of migration brokerage has important implications for migrants’ mobility and wellbeing, not least because of the inflated cost of migration and the increased financial pressure on migrant families as a result. While there is growing attention to debt in the migration scholarship, broader debates on the migration and development nexus continue to underestimate the significance of the issue. Drawing on qualitative research on Vietnamese migrant workers in Taiwan and their families in Vietnam, this paper provides nuanced insights into how debt shapes the ways migrants navigate the transnational migration industry and reproduces inequalities in labour-sending countries. Debt might enable or constrain people's agency and mobility, a relationship that is not static but fluid and context-specific. The study shows that debt is vital for our understanding of transnational contract labour migration in Asia and emphasises temporality and subjectivity in migrants’ experience of and response to debt.},
	journal = {Geoforum},
	author = {Hoang, Lan Anh},
	year = {2020},
}

