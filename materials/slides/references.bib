@article{Gerber:1993c,
	title = {Endogenous {Preferences} and the {Study} of {Institutions}},
	volume = {87},
	issn = {0003-0554},
	doi = {10.2307/2938741},
	abstract = {The assumption that individual preferences, or attitudes, are fixed and exogenously determined is central to many studies of political and economic institutions, such as markets and elections. We present a Bayesian model of adaptive preferences and empirical evidence consistent with that model to argue that preferences are not always exogenous and fixed. The changing relationships between partisanship and preferences on civil rights issues between 1956 and 1964 and on the Vietnam War issue between 1968 and 1972 coincide with significant changes in the major parties' positions on these issues, suggesting that preferences are endogenous to the electoral process. We conclude with a discussion of the positive and normative implications of endogenous preferences.},
	number = {3},
	journal = {American Political Science Review},
	author = {Gerber, Elisabeth R. and Jackson, John E.},
	year = {1993},
	keywords = {campaigns, elections, parties, theory},
	pages = {639--656},
}

@article{Austen-Smith:1988,
	title = {Elections, {Coalitions}, and {Legislative} {Outcomes}},
	volume = {82},
	issn = {0003-0554},
	doi = {10.2307/1957393},
	abstract = {Predictions of electoral behavior in a multiparty setting should be a function of the voters' beliefs about how parties will perform following an election. Similarly, party behavior in a legislature should be a function of electoral promises and rewards. We develop a multistage game-theoretic model of three-party competition under proportional representation. The final policy outcome of the game is generated by a noncooperative bargaining game between the parties in the elected legislature. This game is essentially defined by the vote shares each party receives in the general election, and the parties' electoral policy positions. At the electoral stage parties and voters are strategic in that they take account of the legislative implications of any electoral outcome. We solve for equilibrium electoral positions by the parties and final policy outcomes.},
	number = {2},
	journal = {American Political Science Review},
	author = {Austen-Smith, David and Banks, Jeffrey},
	year = {1988},
	pages = {405--422},
}

@article{Poole:1987a,
	title = {The {Revealed} {Preferences} of {Political} {Action} {Committees}},
	volume = {77},
	issn = {0002-8282},
	abstract = {Massive campaign spending in recent congressional elections has sparked concern with the activities of Political Action Committees (PACs), which have accounted for a large and growing share of campaign finance. The article examines the impact of campaign spending on electoral outcomes, the effect of contributions on legislative behavior, provides an overview of results and the contribution patterns of individual PACs or groups of PACs. A PAC is most likely to contribute to a candidate who is expected to promote policies it favors. Generally, measuring the policy match between a PAC and an incumbent has been ignored or treated in a casual way. It is most likely to give to someone who can be instrumental in favoring its policy goals. To conclude, if the incumbent is expected to be in a close race, the likelihood of both negative for low-rated incumbents and positive for high-rated incumbents contributions is increased. An open research agenda would point to a long term client relationship between a PAC and the few politicians it chooses to support.},
	number = {2},
	journal = {The American Economic Review},
	author = {Poole, Keith T and Romer, Thomas and Rosenthal, Howard},
	year = {1987},
	note = {ISBN: 0002-8282},
	keywords = {JRN},
	pages = {298--302},
}

@article{Graham:2012,
	title = {Moral {Foundations} {Theory}: {The} {Pragmatic} {Validity} of {Moral} {Pluralism}},
	volume = {47},
	issn = {00652601},
	doi = {10.1016/B978-0-12-407236-7.00002-4},
	abstract = {Where does morality come from? Why are moral judgments often so similar across cultures, yet sometimes so variable? Is morality one thing, or many? Moral Foundations Theory (MFT) was created to answer these questions. In this chapter, we describe the origins, assumptions, and current conceptualization of the theory and detail the empirical findings that MFT has made possible, both within social psychology and beyond. Looking toward the future, we embrace several critiques of the theory and specify five criteria for determining what should be considered a foundation of human morality. Finally, we suggest a variety of future directions for MFT and moral psychology. © 2013 Elsevier Inc.},
	journal = {Advances in Experimental Social Psychology},
	author = {Graham, Jesse and Haidt, Jonathan and Koleva, Sena and Motyl, Matt and Iyer, Ravi and Wojcik, Sean P. and Ditto, Peter H.},
	year = {2013},
	keywords = {Cultural learning, Intuition, Method-theory coevolution, Morality, Nativism, Pluralism},
	pages = {55--130},
}

