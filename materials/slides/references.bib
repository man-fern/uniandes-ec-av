@article{Mutz:1997,
	title = {Dimensions of {Sociotropic} {Behavior}: {Group}-{Based} {Judgements} of {Fairness} and {Well}-{Being}},
	volume = {41},
	issn = {00925853},
	doi = {10.2307/2111717},
	abstract = {Mutz and Mondak propose three ways in which groups may influence economic perceptions: as proxies for self-interest, as sources of information that are trustworthy and relevant, and as sources of political influence. They look at group membership (as measured objectively or subjectively), group identification (sense of attachment), and group comparison (relative deprivation and sociotropic fairness). They use a three-wave panel study to test their theory, and their model allows for economic perceptions to influence the vote directly and through partisan identification. They find that sociotropic fairness (the perception that groups have equally experienced economic change) outweighs sociotropic well-being and conclude that group-based judgments have an independent influence. However, their measure of perceived inequality is significantly correlated with partisanship, leading me to question their findings (in my response paper).},
