@book{Murphy:1964,
	address = {Chicago},
	title = {Elements of {Judicial} {Strategy}.},
	volume = {9},
	issn = {00263397},
	doi = {10.2307/2109207},
	abstract = {Murphy provides a framework within which a justice may operate to achieve their goals. His work focusses on the capabilities of the judicial branch to shape public policies and most efficient ways to use their resources, official and personal, to achieve a particular policy. Murphy highlights the element of rationality when judges use their resources. For him rationality would mean “geared as efficiently as possible to maximize goal achievement”. (Murphy 1973, 4-5) According to Murphy, the role of scholars is not to determine whether judges have exercise discretion, but whether they have done so in a manner permitted by standards. Scholars should not focus on whether the judges have influenced policy, but whether this policy in beneficial for the society in the short and long term. Using Weber’s legitimacy framework (legal, traditional, charismatic), Murphy claims that the justices of the Supreme Court use legal, traditional and charismatic arguments to place themselves as arbiters between the other two branches of power. As part of the framework of judicial power he analyzes the scope and sources of judicial power (legal, traditional, charismatic) and the instruments available to justices (authority to decide cases, prestige and reputation, control over its own jurisdiction, legal technicalities, restricting their decisions) as well as the limitations and instances at which those restrains could be more detrimental (the restraint of public opinion, technical checks, the power of Congress, the President, state government and interests group leaders and judicial self-restraint) The prestige of the Court lies in the charismatic source of judicial power. For Murphy “the sacred, mysterious character of the Constitution has been caught by the Justices in the performance of their priestly duty of expounding the meaning of that holy writ”(Murphy 1973, 16) Thus, this judicial myth, according to Murphy has protected the Court against assaults. In the third chapter Murphy emphasizes the opportunities within the Court for persuasion by negotiation and accommodation. For him, one of the main problems that a justice will confront is obtaining a majority decision, by influencing other judges “with as little expenditure of time and energy as possible”.},
	publisher = {University of Chicago Press},
	author = {Aumann, Francis R. and Murphy, Walter F.},
	year = {1965},
	note = {Publication Title: Midwest Journal of Political Science
Issue: 2},
}

