@article{Eslava2019,
	title = {Job {Creation} in {Colombia} vs the {U}.{S}.: '{Up} or {Out} {Dynamics}' {Meets} 'the {Life} {Cycle} of {Plants}'},
	issn = {1556-5068},
	url = {https://www.ssrn.com/abstract=3334528},
	doi = {10.2139/ssrn.3334528},
	abstract = {There is growing consensus that a key difference between the U.S. and developing economies is that the latter exhibit slower employment growth over the life cycle of the average business. At the same time, the rapid post entry growth in the U.S. is driven by an “up or out dynamic”. We track manufacturing establishments in Colombia vs. the US and find that slower average life cycle growth in Colombia is driven by a less enthusiastic contribution of extraordinary growth plants and less dynamic selection of young underperforming plants. As a consequence, the size distribution of non-micro plants exhibits more concentration in small-old plants in Colombia, both in unweighted and employment-weighted bases. These findings point to a shortage of highgrowth entrepreneurship and a relatively high likelihood of long-run survival for small, likely unproductive plants, as two key elements at the heart of the development problem. An extreme concentration of resources in micro plants is the other distinguishing feature of the Colombian manufacturing sector vis a vis the US.},
	journal = {SSRN Electronic Journal},
	author = {Eslava, Marcela and Haltiwanger, John C. and Pinzon G., Alvaro-Jose},
	year = {2019},
}

@article{Ayyagari2014,
	title = {Who creates jobs in developing countries?},
	volume = {43},
	issn = {0921-898X},
	url = {http://link.springer.com/10.1007/s11187-014-9549-5},
	doi = {10.1007/s11187-014-9549-5},
	abstract = {This paper investigates the contribution of small firms to employment, job creation, and growth in developing countries. While small firms ({\textless}20 employees) have the smallest share of aggregate employment, the small and medium enterprise sector's ({\textless}100 employees) contribution is comparable to that of large firms. Small firms have the largest shares of job creation, and highest sales growth and employment growth, even after controlling for firm age. Large firms, however, have higher productivity growth. Conditional on size, young firms are the fastest growing and large mature firms have the largest employment shares but small young firms have higher job creation rates. © 2014 Springer Science+Business Media New York.},
	number = {1},
