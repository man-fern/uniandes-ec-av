@article{Lindstadt:2011,
	title = {Timely shirking: {Time}-dependent monitoring and its effects on legislative behavior in the {U}.{S}. {Senate}},
	volume = {148},
	issn = {00485829},
	doi = {10.1007/s11127-010-9649-y},
	abstract = {We examine legislative shirking under conditions of imperfect constituent monitoring. Our core argument states that variation in information costs and constituent memory leads to systematic variation in constituent monitoring over time. Assuming that legislators are responsive to multiple cues, we expect to observe time-dependent legislative shirking. We develop a theoretical model of legislative behavior with time-dependent monitoring, which we test empirically using Senate roll call data. Our findings show that a substantial number of senators engage in systematic, time-dependent shirking, and that senators consistently move toward extreme positions when monitoring is low and toward moderate positions when it is high. © 2010 Springer Science+Business Media, LLC.},
