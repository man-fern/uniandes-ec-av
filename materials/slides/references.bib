@article{Elinder2017,
	title = {House price responses to a national property tax reform},
	volume = {144},
	issn = {01672681},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0167268117302585},
	doi = {10.1016/j.jebo.2017.09.017},
	abstract = {We show that house prices in general did not respond to a substantial cut in the national property tax in Sweden. The estimates are based on rich register data covering more than 100,000 sales over a time period of two and a half years. Because the Swedish property tax is national and thus unrelated to local public goods, our setting is ideal for causal identification of the property tax on house prices. We observe price increases only in a small segment of the market containing properties with very high tax values. We discuss, but can admittedly not empirically discriminate between, several potential explanations for why we find no evidence of capitalization except for the top segment of the market.},
	journal = {Journal of Economic Behavior \& Organization},
	author = {Elinder, Mikael and Persson, Lovisa},
