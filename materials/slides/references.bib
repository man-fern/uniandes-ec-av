	author = {Erten, Bilge and Ocampo, José Antonio},
	year = {2013},
	keywords = {Band-pass filters, Commodity prices, Prebisch-Singer hypothesis, Prebisch–Singer hy, Super cycles, commodity prices, super cycles},
	pages = {14--30},
}

@article{Keane2010,
	title = {Structural vs. atheoretic approaches to econometrics},
	volume = {156},
	issn = {03044076},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-77950020001&doi=10.1016%2Fj.jeconom.2009.09.003&partnerID=40&md5=a91cfb4c6579ee31d703dbfcef381b2b},
	doi = {10.1016/j.jeconom.2009.09.003},
	abstract = {In this paper I attempt to lay out the sources of conflict between the so-called "structural" and "experimentalist" camps in econometrics. Critics of the structural approach often assert that it produces results that rely on too many assumptions to be credible, and that the experimentalist approach provides an alternative that relies on fewer assumptions. Here, I argue that this is a false dichotomy. All econometric work relies heavily on a priori assumptions. The main difference between structural and experimental (or "atheoretic") approaches is not in the number of assumptions but the extent to which they are made explicit. © 2009 Elsevier B.V. All rights reserved.},
	number = {1},
	journal = {Journal of Econometrics},
	author = {Keane, Michael P.},
	year = {2010},
	keywords = {Dynamic models, Instrumental variables, Life-cycle models, Natural experiments, Structural models},
	pages = {3--20},
}

