@article{Kiewiet:1993,
	title = {Constitutional limitations on borrowing: {An} analysis of state bonded indebtedness},
	volume = {12},
	issn = {87566222},
	doi = {10.1093/oxfordjournals.jleo.a023362},
	abstract = {State and local governments have long had constitutional limits on the issuance of full faith and credit debt. Our analyses find that levels of such debt depend upon the type of restriction in place. States that either prohibit guaranteed debt or require referendum approval to issue it have less guaranteed debt than those that require a supermajority of the legislature to issue debt or those that have revenue-based limitations. Although the issuance of state nonguaranteed debt does not appear to be generally motivated by the aim of circumventing constitutional limitations on guaranteed debt, restrictive provisions at the state level do result in the devolution of debt issuance to governments at the local level. Our findings suggest that current proposals for constitutional limitations on borrowing at the federal level would have much less impact on total government borrowing than their proponents anticipate.},
	number = {1},
