	volume = {91},
	issn = {0022-3808},
	doi = {10.1086/261181},
	abstract = {This paper extends Stigler and Peltzman's approach to regulation by{\textbackslash}nincorporating a legislature. The model yields comparative statics results{\textbackslash}nand hence testable implications. The paper then tests between{\textbackslash}ntwo opposing approaches about regulatory agency behavior. The{\textbackslash}nfirst assumes agencies operate independently of the legislature and{\textbackslash}nhence exercise discretion; the second assumes that Congress controls{\textbackslash}nagency decisions. The recent behavior of the Federal Trade Colnmission{\textbackslash}nprovides the empirical setting. Substantial evidence is found{\textbackslash}nfor the specific predictions of the model, including the hypothesis of{\textbackslash}nsystematic congressional influence over FTC decisions.},
