@article{Stimson:1994,
	title = {Opinion and {Policy}: {A} {Global} {View}},
	volume = {27},
	issn = {10490965},
	doi = {10.2307/420454},
	abstract = {Can policymakers improve their knowledge of public preferences on specifics beyond what is expressed, indeed beyond even what the public knows? We believe that they can. All that is required is for them to be knowledgeable about the general contours of opinion so that they can reliably infer specific from general. Policy makers can anticipate what public opinion would be if it had crystallized on a particular issue. Any they may well be better off doing so than attending to known specific opinions.},
