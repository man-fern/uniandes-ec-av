@article{Mollick14,
	title = {The dynamics of crowdfunding: {An} exploratory study},
	volume = {29},
	issn = {08839026},
	doi = {10.1016/j.jbusvent.2013.06.005},
	abstract = {Crowdfunding allows founders of for-profit, artistic, and cultural ventures to fund their efforts by drawing on relatively small contributions from a relatively large number of individuals using the internet, without standard financial intermediaries. Drawing on a dataset of over 48,500 projects with combined funding over \$237. M, this paper offers a description of the underlying dynamics of success and failure among crowdfunded ventures. It suggests that personal networks and underlying project quality are associated with the success of crowdfunding efforts, and that geography is related to both the type of projects proposed and successful fundraising. Finally, I find that the vast majority of founders seem to fulfill their obligations to funders, but that over 75\% deliver products later than expected, with the degree of delay predicted by the level and amount of funding a project receives. These results offer insight into the emerging phenomenon of crowdfunding, and also shed light more generally on the ways that the actions of founders may affect their ability to receive entrepreneurial financing. © 2013 The Author.},
	number = {1},
	journal = {Journal of Business Venturing},
	author = {Mollick, Ethan},
	year = {2014},
	keywords = {Crowdfunding, Entrepreneurial finance, Geography, New ventures, Startups},
	pages = {1--16},
}

@article{Autoretal16,
	title = {The {China} {Shock}: {Learning} from {Labor}-{Market} {Adjustment} to {Large} {Changes} in {Trade}},
	volume = {8},
	issn = {19411391},
	url = {https://ideas.repec.org/a/anr/reveco/v8y2016p205-240.html},
	doi = {10.1146/annurev-economics-080315-015041},
	abstract = {China's emergence as a great economic power has induced an epochal shift in patterns of world trade. Simultaneously, it has challenged much of the received empirical wisdom about how labor markets adjust to trade shocks. Alongside the heralded consumer benefits of expanded trade are substantial adjustment costs and distributional consequences. These impacts are most visible in the local labor markets in which the industries exposed to foreign competition are concentrated. Adjustment in local labor markets is remarkably slow, with wages and labor-force participation rates remaining depressed and unemployment rates remaining elevated for at least a full decade after the China trade shock commences. Exposed workers experience greater job churning and reduced lifetime income. At the national level, employment has fallen in the US industries more exposed to import competition, as expected, but offsetting employment gains in other industries have yet to materialize. Better understanding when and where trade is costly, and how and why it may be beneficial, is a key item on the research agenda for trade and labor economists.},
	number = {1},
	journal = {Annual Review of Economics},
	author = {Autor, David and Dorn, David and Hanson, Gordon H.},
	month = oct,
	year = {2016},
	keywords = {Globalization, Inequality, Labor-market adjustment, Local labor markets, globalization, labor-market adjustment, local labo},
	pages = {205--240},
}

