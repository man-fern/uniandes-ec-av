@article{Rodrik2024,
	title = {A {New} {Growth} {Strategy} for {Developing} {Nations}},
	abstract = {enero 2024 No hace mucho tiempo, la comunidad del desarrollo rebosaba de optimismo sobre las perspectivas económicas del mundo en desarrollo. El crecimiento económico aumentó, la pobreza extrema disminuyó drásticamente y parecía haber surgido un consenso claro sobre las líneas generales de una estrategia de crecimiento basada en la integración en la economía mundial. Hubo muchos debates sobre los detalles de la estrategia: la experiencia de China, que había diseñado la reducción de la pobreza más espectacular de la historia, dio argumentos a los defensores de enfoques de desarrollo tanto orientados al mercado como más dirigidos por el Estado.. Pero ambas partes coincidieron en que, independientemente de cómo se lograra, la industrialización orientada a la exportación era el camino a seguir. Este consenso se ha visto destrozado por varios acontecimientos. Algunas de ellas tardaron mucho en prepararse. En par�cular, los cambios tecnológicos han hecho que la manufactura sea intensiva en habilidades y capital y absorba cada vez menos mano de obra. Esto socavó la eficacia de la industrialización como estrategia de crecimiento. La capacidad de la estrategia de crecimiento para absorber mano de obra se redujo al mismo tiempo que se atenuó al menos la ventaja comparativa de los países en desarrollo. Como muestra la Figura 1, las tasas de crecimiento económico en el mundo en desarrollo ya estaban cayendo en los años previos a la pandemia de Covid. La propia pandemia aceleró y hizo visibles otras tendencias más sutiles. Con un menor crecimiento, los problemas de deuda de los países en desarrollo se volvieron abrumadores y los países de ingresos bajos y medianos bajos perdieron el acceso a los mercados financieros. La competencia geopolítica entre Estados Unidos y China y la creciente reacción contra la hiperglobalización transformaron el panorama económico global y hicieron que la economía mundial fuera menos hospitalaria para el crecimiento a través del comercio. A medida que aumentaron los ingresos en los países desarrollados, hubo un abandono de los bienes manufacturados hacia los servicios, por lo que la participación de la producción mundial en el sector manufacturero disminuyó. La inminente crisis del cambio climático y la necesaria transición verde afectaron negativamente a los sectores agrícolas de muchos países en desarrollo. También redujo la demanda mundial de bienes materiales, especialmente aquellos con una alta huella de carbono, a diferencia de los servicios, y convirtió el desarrollo de nuevas tecnologías en un imperativo, lo que desfavoreció aún más a los países en desarrollo. 1Universidad de Harvard y Universidad de Columbia, respec�vamente. Este es un ensayo preparado para el Proyecto IEA-ERIA sobre el Nuevo Orden Económico Global.},
	number = {January},
	journal = {New Global Economic Order},
	author = {Rodrik, Dani and Stiglitz, Joseph},
	year = {2024},
	keywords = {⛔ No DOI found},
}

