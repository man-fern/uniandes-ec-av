@article{Lebo:2007,
	title = {Strategic party government: {Party} influence in congress, 1789-2000},
	volume = {51},
	issn = {00925853},
	doi = {10.1111/j.1540-5907.2007.00262.x},
	abstract = {Why does the influence of Congressional parties fluctuate over time? Building on prevailing answers, we develop a model, Strategic Party Government, which highlights the electoral motives of legislative parties and the strategic interaction between parties. We test this theory using the entire range of House and Senate party behavior from 1789 to 2000 and find that the strategic behavior of parties complements members' preferences as an explanation for variation in party influence. Specifically, the strongest predictors of one party's voting unity are the unity of the opposing party and the difference between the parties in the preceding year. Moreover, we find strong links between party behavior in Congress and electoral outcomes: an increase in partisan influence on legislative voting has adverse electoral costs, while winning contested votes has electoral benefits. © 2007, Midwest Political Science Association.},
	number = {3},
	journal = {American Journal of Political Science},
	publisher = {Wiley Online Library},
	author = {Lebo, Matthew J. and McGlynn, Adam J. and Koger, Gregory},
	year = {2007},
	pages = {464--481},
}

