	pages = {2801--2824},
}

@article{Porta2008,
	title = {The {Unofficial} {Economy} and {Economic} {Development}},
	issn = {1556-5068},
	url = {http://www.ssrn.com/abstract=1304760},
	doi = {10.2139/ssrn.1304760},
	abstract = {In developing countries, informal firms account for up to about half of all economic activity. Using data from World Bank firm-level surveys, we find that informal firms are small and extremely unproductive compared with even the small formal firms in the sample, and especially relative to the larger formal firms. Formal firms are run by much better educated managers than informal ones and use more capital, have different customers, market their products, and use more external finance. Few formal firms have ever operated informally. This evidence supports the dual economy ("Wal-Mart") theory of development, in which growth comes about from the creation of highly productiveformal firms. Informal firms keep millions of people alive but disappear as the economy develops.},
	number = {2},
	journal = {SSRN Electronic Journal},
	author = {La Porta, Rafael and Shleifer, Andrei},
	year = {2008},
}

@article{cunha2007technology,
	title = {The technology of skill formation},
	volume = {97},
	issn = {00028282},
	doi = {10.1257/aer.97.2.31},
	abstract = {A technology of cognitive and noncognitive skill formation that features self-productivity, dynamic complementarity, and skill multipliers explains a variety of findings established in the child development and child intervention literatures. Although we have focused on cognitive and noncognitive skills, our analysis also applies to the formation of physical health capital (see Heckman 2007). The evidence on the importance of early childhood environments on adult health (David J. P. Barker 1998; and Anne Case, Angela Fertig, and Christina Paxson 2005) can be rationalized by our technology. Stocks of cognitive and noncognitive skills facilitate the accumulation of health capital through self-regulation and choices. Stocks of health skills also raise the productivity of schooling (Alok Bhargava 2008).},
	number = {2},
	journal = {American Economic Review},
	author = {Cunha, Flavio and Heckman, James J.},
	year = {2007},
	pages = {31--47},
}

