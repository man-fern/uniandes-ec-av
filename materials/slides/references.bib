	title = {Capital-{Skill} {Complementarity}, {Income} {Distribution}, and {Output} {Accounting}},
	volume = {83},
	issn = {0022-3808},
	url = {https://www.journals.uchicago.edu/doi/10.1086/260323},
	doi = {10.1086/260323},
	abstract = {This article presents evidence for the view that physical capital{\textbackslash}nis more complementary to educated labor than to less educated labor.{\textbackslash}nFor this reason previous estimates of elasticities of substitution{\textbackslash}nbetween educated and less educated labor are too high. Using a two-level{\textbackslash}nCES production function, we run international cross-sectional regressions{\textbackslash}nat the level both of the economy and of individual sectors. The whole-economy{\textbackslash}nmodel allows for the effects of wages on educational choices as well{\textbackslash}nas vice versa. It predicts that, as total capitalper head rises,{\textbackslash}nthe share of physical capital in national income falls and that of{\textbackslash}nhuman capital rises. The production function also shows that intercountry{\textbackslash}ndifferences in output per head are due more to differences in physical{\textbackslash}ncapital than in human capital.},
