	issn = {03044076},
	doi = {10.1016/j.jeconom.2007.05.002},
	abstract = {This paper reviews the history of the regression discontinuity design in three academic disciplines. It describes the design's birth and subsequent demise in Psychology even though most problems with it had been solved there. It further describes the scant interest shown in the design by scholars formally trained in Statistics, and the design's poor reception in Economics from 1972 until about 1995, when its profile and acceptance changed. Reasons are given for this checkered history that is characterized as waiting for life to arrive. © 2007 Elsevier B.V. All rights reserved.},
