	author = {Cacioppo, John T. and Petty, Richard E.},
	year = {1982},
	keywords = {development \&, validation, Need for Cognition Scale, faculty memb},
	pages = {116--131},
}

@article{Niemi:1991,
	title = {Candidacies and {Competitiveness} in {Multimember} {Districts}},
