	doi = {10.1016/0304-4076(87)90075-3},
	abstract = {Choice probabilities generated by McFadden's random utility model are both multinomial logit and have the Independence of Irrelevant Alternatives property. Various authors have suggested specification tests of this property. This paper identifies the alternative against which these tests are constructed and obtains classical specification tests. It is shown that both the null hypothesis and local asymptotic power of the classical tests is the same as for a proposed Hausman test. Finally the discussion throws some light on the nature of the IIA property and on the performance of the logit model in applications where one would expect the IIA property to be violated but where the alternative set is fixed. © 1987.},
