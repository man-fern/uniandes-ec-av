	doi = {10.1016/0167-2681(92)90054-F},
	abstract = {This study tests the hypothesis that the sensitivity of the president's popularity to economic events differs across distinct demographic groups Assuming that presidental popularity is negatively related to both the unemployment rate and the inflation rate, the electorate is disaggregated according to sex, age, race, education, income, and political affiliation and separate regressions are estimated for the individual subgroups using quarterly data covering 1976 through 1988 Statistically significant differences in the marginal effects of unemployment and inflation on presidential approval are discovered for the various subgroupings. © 1992.},
