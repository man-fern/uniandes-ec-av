	abstract = {The conventional wisdom about presidential campaigning in midterm Senate elections is that presidential efforts lack impact or have negative impact. We discuss conceptual problems with the conventional view and offer an alternative that views presidential campaigning as strategic. We test this alternative and find support for it. Further, we find that presidential campaign efforts have a positive impact on the vote through the mobilization of nonvoters. Finally, in a significant number of cases, presidential campaigning may have been the margin of victory for candidates of the president's party. We discuss the implications of these findings on assessments of the president and relations with Congress during the second half of the term.},
	number = {1},
	journal = {American Political Science Review},
	author = {Cohen, Jeffrey E. and Krassa, Michael A. and Hamman, John A.},
	year = {1991},
	pages = {165--178},
}

