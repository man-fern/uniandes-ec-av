@article{Matsumoto:1998,
	title = {Mersenne {Twister}: {A} 623-{Dimensionally} {Equidistributed} {Uniform} {Pseudo}-{Random} {Number} {Generator}},
	volume = {8},
	issn = {10493301},
	doi = {10.1145/272991.272995},
	abstract = {A new algorithm called Mersenne Twister (MT) is proposed for generating uniform pseudorandom numbers. For a particular choice of parameters, the algorithm provides a super astronomical period of 219937 - 1 and 623-dimensional equidistribution up to 32-bit accuracy, while using a working area of only 624 words. This is a new variant of the previously proposed generators, TGFSR, modified so as to admit a Mersenne-prime period. The characteristic polynomial has many terms. The distribution up to v bits accuracy for 1 ≤ v ≤ 32 is also shown to be good. An algorithm is also given that checks the primitivity of the characteristic polynomial of MT with computational complexity O(p2) where p is the degree of the polynomial. We implemented this generator in portable C-code. It passed several stringent statistical tests, including diehard. Its speed is comparable to other modern generators. Its merits are due to the efficient algorithms that are unique to polynomial calculations over the two-element field.},
	number = {1},
	journal = {ACM Transactions on Modeling and Computer Simulation},
	author = {Matsumoto, Makoto and Nishimura, Takuji},
	year = {1998},
	keywords = {Finite fields, GFSR, Incomplete array, Inversive-decimation method, M-sequences, MT19937, Mersenne Primes, Mersenne Twister, Multiple-recursive matrix method, Primitive polynomials, Random number generation, TGFSR, Tempering, k-distribution},
	pages = {3--30},
}

@article{Proksch:2010,
	title = {Position taking in european parliament speeches},
	volume = {40},
	issn = {00071234},
	doi = {10.1017/S0007123409990299},
	abstract = {This article examines how national parties and their members position themselves in European Parliament (EP) debates, estimating the principal latent dimension of spoken conflict using word counts from legislative speeches. We then examine whether the estimated ideal points reflect partisan conflict on a left-right, European integration or national politics dimension. Using independent measures of national party positions on these three dimensions, we find that the corpus of EP speeches reflects partisan divisions over EU integration and national divisions rather than left-right politics. These results are robust to both the choice of language used to scale the speeches and to a range of statistical models that account for measurement error of the independent variables and the hierarchical structure of the data. Copyright © 2010 Cambridge University Press.},
	number = {3},
	journal = {British Journal of Political Science},
	author = {Proksch, Sven Oliver and Slapin, Jonathan B.},
	year = {2010},
	pages = {587--611},
}

@book{Erikson:2002,
	address = {New York},
	title = {The {Macro} {Polity}},
	volume = {38},
	issn = {0001-6810},
	doi = {10.1057/palgrave.ap.5500015},
	abstract = {Fifty years of research characterizes the average American as a disinterested, poorly informed, marginally participatory citizen. Conversely, we find order and democratic accountability when we study electorates and the institutions they influence. Robert S. Erikson, Michael B. MacKuen, and James A. Stimson emphasize this “radical discontinuity between the impressions and conclusions reached from the study of individuals and aggregates” (xviii), and they argue that our understanding of the macro polity is divorced from our knowledge of individual behavior. They propose a complete reorientation of the way we think about aggregate-level American politics. In short, they argue that the apparently random choices of the vast number of uninformed voters “cancel out” (429). In the aggregate, the meaningful evaluations of a small percentage of attentive voters dominate the seemingly random component. Since this informed and active v oting bloc draws the attention of elected officials, a largely uninformed public is not necessarily inconsistent with representative democracy. F rom a “systems” perspective, the authors examine the interrelationships between economic performance and the content of enacted policies and presi- dential approval, public mood, and partisanship. Interesting insights are scattered throughout the volume. For example, aggregate voter evaluations of economic performance are prospective rather than retrospective. And though individual- level partisanship is quite stable, aggregate partisanship— macropartisanship — v aries systematically over time. Significantly, the net effect of individual shifts in partisan allegiance—not generational replacement—is still primarily responsible for this variation.},
	publisher = {Cambridge University Press},
	author = {de Vries, Michiel S},
	year = {2003},
	note = {Publication Title: Acta Politica
Issue: 2},
}

@article{Asher:1978,
	title = {Voting {Change} in {Congress}: {Some} {Dynamic} {Perspectives} on an {Evolutionary} {Process}},
	volume = {22},
	issn = {00925853},
	doi = {10.2307/2110622},
	abstract = {This article presents and tests an evolutionary model of congressional voting change that is based on the legislator following his "voting history" on an issue until changing circumstances force a change. Issue evolution, membership replacement, and partisan shift in control of the presidency are identified as three sources of change. House votes from 1949 to 1972 on debt ceiling, foreign aid, school construction, and civil rights are examined to assess the effects of the three sources of change. In general, there is considerable stability in congressional roll-call voting over time with the change that does occur tending to be gradual rather than dramatic.},
	number = {2},
	journal = {American Journal of Political Science},
	author = {Asher, Herbert B. and Weisberg, Herbert F.},
	year = {1978},
	pages = {391},
}

@article{Liebowitz:1980,
	title = {A {Theory} of {Legislative} {Organization}: {Making} the {Most} of {Your} {Majority}},
	volume = {94},
	issn = {00335533},
	doi = {10.2307/1884540},
	abstract = {In this paper we seek to explain why legislative committees exist and what is the optimal number and size of committees in a legislature. Our theory is based on the idea that committees are a "sample" taken from the full house and on the assumption that the majority party seeks to maximize the proportion of its favored bills which are reviewed and passed in voting trials. We show that for a given size of majority fewer and larger committees lead to larger passage rates, if majority members do not always vote the party-line. [ABSTRACT FROM AUTHOR]},
	number = {2},
	journal = {The Quarterly Journal of Economics},
	author = {Leibowitz, Arleen and Tollison, Robert},
	year = {1980},
	pages = {261},
}

@article{Hix:2004,
	title = {Electoral {Institutions} and {Legislative} {Behavior}: {Explaining} {Voting} {Defection} in the {European} {Parliament}},
	volume = {56},
	issn = {0043-8871},
	doi = {10.1353/wp.2004.0012},
	abstract = {Despite a sophisticated understanding of the impact of electoral institutions on macrolevel political behavior, little is known about the relationship between these institutions and microlevel legislative behavior. This article reviews existing claims about this relationship and develops a model for predicting how electoral institutions affect the relationship between parliamentarians and their party principals in the context of the European Parliament. The European Parliament is an ideal laboratory for investigating these effects, because in each European Union member state, different institutions are used to elect Members of European Parliament (MEPs). The results of this model, tested on four hundred thousand individual MEP vote decisions, show that candidate-centered electoral systems (such as open-list proportional representation or single-transferable-vote systems) and decentralized candidate-selection rules produce parliamentarians independent from their party principals. By contrast, party-centered electoral systems (such as closed-list proportional representation systems) and centralized candidate-selection rules produce parliamentarians beholden to the parties that fight elections and choose candidates: in the case of the European Parliament, the national parties.},
	number = {2},
	journal = {World Politics},
	author = {Hix, Simon},
	year = {2004},
	pages = {194--223},
}

@book{Erikson:1995,
	address = {Boston},
	title = {American {Public} {Opinion}},
	doi = {10.4324/9781351034746},
	abstract = {Updated in a new 8 th edition, this book goes beyond a simple presentation of data to include a critical analysis of the role of public opinion in American democracy. It provides an in-depth analysis of public opinion, beginning with its origins in political socialization, the impact of the media, the extent and breadth of democratic values, to the role of public opinion in the electoral process. Using the most current survey data from the 2008 elections and the latest literature on the subject, Erikson and Tedin analyze public opinion and its role in the policy and politics of the United States.},
	publisher = {Allyn and Bacon},
	author = {Erikson, Robert S. and Tedin, Kent L.},
