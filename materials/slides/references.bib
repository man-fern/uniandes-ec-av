@article{ranaldi2018measurement,
	title = {On the {Measurement} of {Functional} {Income} {Distribution}},
	abstract = {This study aims to develop a methodological architecture, which sheds light on the structure of functional income classes, and on the distribution of functional income among people in general. A func- tional income class is here defined as a group of individuals whose income, at the aggregate level, is simultaneously fueled by different factor shares, in specific proportions. A new index that captures the distribution of functional income among individuals or popula- tion groups is proposed: the Functional Income Distribution Index (If , or If ), which will take various mathematical forms throughout the article. It is shown how the simplest version of the If is closely connected to the Gini Index, and how some other properties of the coefficient can be further derived. The extension of the methodology will intuitively follow, in a straightforward manner, from its geomet- rical representation. After a first methodological examination, a brief empirical analysis tests the If .},
	author = {Ranaldi, Marco},
	year = {2016},
	keywords = {Factor Shares, Functional Income, Inequality, Statistical Methodology, ⛔ No DOI found},
}

