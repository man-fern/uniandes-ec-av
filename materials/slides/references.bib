	keywords = {⛔ No DOI found},
}

@article{Louch:2000,
	title = {Personal network integration: {Transitivity} and homophily in strong-tie relations},
	volume = {22},
	issn = {03788733},
	doi = {10.1016/S0378-8733(00)00015-0},
	abstract = {This article combines studies of transitivity and homophily in an empirical analysis of personal network integration. Using a national sample of individual's personal networks, the paper reveals that transitivity explains a majority of cases of network integration with two important caveats: (1) recent work on networks and social structure points to important structural constraints on personal networks that shape their formation, and (2) homophily (e.g. sex or race) and choice homophily (e.g. religion) improve the likelihood of integration in personal networks. The results indicate that the second finding interacts with relationship length and the availability of focal points to organize individual contact. © 2000 Elsevier Science B.V.},
	number = {1},
	journal = {Social Networks},
	author = {Louch, Hugh},
	year = {2000},
	pages = {45--64},
}

