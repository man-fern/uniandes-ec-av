@article{Einavetal2018,
	title = {Provider {Incentives} and {Healthcare} {Costs}: {Evidence} {From} {Long}-{Term} {Care} {Hospitals}},
	volume = {86},
	issn = {0012-9682},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.3982/ECTA15022},
	doi = {10.3982/ECTA15022},
	abstract = {We study the design of provider incentives in the post-acute care setting-a high-stakes but under-studied segment of the healthcare system. We focus on long-term care hospitals (LTCHs) and the large (approximately \$13,500) jump in Medicare payments they receive when a patient's stay reaches a threshold number of days. Discharges increase substantially after the threshold, with the marginal discharged patient in relatively better health. Despite the large financial incentives and behavioral response in a high mortality population, we are unable to detect any compelling evidence of an impact on patient mortality. To assess provider behavior under counterfactual payment schedules, we estimate a simple dynamic discrete choice model of LTCH discharge decisions. When we conservatively limit ourselves to alternative contracts that hold the LTCH harmless, we find that an alternative contract can generate Medicare savings of about \$2,100 per admission, or about 5\% of total payments. More aggressive payment reforms can generate substantially greater savings, but the accompanying reduction in LTCH profits has potential out-of-sample consequences. Our results highlight how improved financial incentives may be able to reduce healthcare spending, without negative consequences for industry profits or patient health.},
	number = {6},
	journal = {Econometrica},
	author = {Einav, Liran and Finkelstein, Amy and Mahoney, Neale},
	year = {2018},
	keywords = {Healthcare, financial incentives, nonlinear contracts, post-acute care},
	pages = {2161--2219},
}

@article{Espinal-Piedrahita2022,
	title = {Financiamiento del sistema de salud colombiano: {Tendencias} y desafíos},
	volume = {24},
	issn = {2539-3596},
	url = {https://revistas.unal.edu.co/index.php/revsaludpublica/article/view/103057},
	doi = {10.15446/rsap.v24n1.103057},
	abstract = {El financiamiento es una función fundamental que contribuye al propósito que tienen los sistemas de salud de mejorar el estado de salud de la población. Esta función se concreta en la recaudación de fondos, su mancomunación y asignación, y en ella se diferencian las fuentes y los usos de los recursos, especialmente en cuanto al carácter público o privado y a la forma como se cubren los costos de los servicios de salud. En este artículo se presenta una mirada de largo plazo sobre el financiamiento de la salud en Colombia, identificando los antecedentes y la evolución a partir de la reforma de 1993. Se identifican cuatro momentos en esta evolución: 1) incremento significativo de recursos, al momento de expedir las Leyes 60 y 100 de 1993; 2) contención fiscal, en el marco de la crisis de 1998 y 1999; 3) mayor esfuerzo fiscal, especialmente a partir de 2010, y 4) sustitución de fuentes, de cotizaciones a impuestos generales, que se inició en 2012. Se evidencia un desarrollo importante de la función de financiamiento, con un fortalecimiento a partir de la Administradora de los Recursos del Sistema (ADRES), la reducción en la dependencia de las cotizaciones, el proceso de igualación per cápita entre regímenes de aseguramiento, y un mayor aporte de impuestos generales para buscar el equilibrio del sistema. Todo ello implica mantener el predominio público y garantizar la protección financiera en salud.},
	number = {1},
	journal = {Revista de Salud Pública},
	author = {Espinal-Piedrahita, Juan José and Restrepo-Zea, Jairo Humberto},
	month = jan,
	year = {2022},
	pages = {1--8},
}

@article{Baron-Leguizamon2022,
	title = {Composición y evolución del gasto en salud de {Colombia} y su financiamiento en el periodo 2013-2018},
	volume = {24},
	issn = {2539-3596},
	url = {https://revistas.unal.edu.co/index.php/revsaludpublica/article/view/103052},
	doi = {10.15446/rsap.v24n1.103052},
	abstract = {Objetivo Examinar la magnitud, la composición y evolución del gasto en salud de Colombia y su forma de financiamiento durante el periodo 2013‑2018, con el propósito de aportar evidencia reciente para el mejor conocimiento y seguimiento de los flujos de recursos del sistema de salud. Métodos El análisis se sustenta en los conceptos y clasificaciones de la metodología SHA-2011 adoptada en la actualidad por la mayoría de los países miembros de la Organización Mundial de la Salud para sus estimaciones anuales del gasto en salud. La fuente principal de información es la base de datos de gasto global en salud de la misma entidad, algunos de cuyos resultados se complementan con cálculos adicionales utilizando fuentes oficiales nacionales. Resultados Desde el lado del gasto, el componente más importante corresponde al gasto público en salud, el cual representa, en promedio, 76,4\% del gasto corriente en salud para el periodo en referencia, cuyo financiamiento con recursos públicos fiscales y contribuciones a la seguridad social representa 70,6\% del financiamiento total; en tanto que el restante 23,6\% corresponde al financiamiento privado representado por los pagos de bolsillo de los hogares (15,8\%) y los pagos de seguros voluntarios (7,8\%) también como promedios del mismo periodo. Conclusiones Colombia, como la mayoría de los países latinoamericanos, sigue un modelo de financiamiento predominantemente público, cuya composición de fondos registró un cambio en favor de los recursos de origen fiscal, como resultado de un cambio en las políticas de financiamiento durante el periodo analizado.},
	number = {1},
	journal = {Revista de Salud Pública},
	author = {Barón-Leguizamón, Gilberto},
	month = jan,
	year = {2022},
	pages = {1--9},
}

