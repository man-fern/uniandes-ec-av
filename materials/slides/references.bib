@article{kaplinsky2006,
	title = {Revisiting the revisited terms of trade: {Will} {China} make a difference?},
	volume = {34},
	issn = {0305750X},
	url = {http://www.sciencedirect.com/science/article/pii/S0305750X06000416},
	doi = {10.1016/j.worlddev.2005.11.011},
	abstract = {Summary
