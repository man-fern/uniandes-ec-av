}

@article{Kahn:1991,
	title = {Senate {Elections} in the {News}: {Examining} {Campaign} {Coverage}},
	volume = {16},
	issn = {03629805},
	doi = {10.2307/440102},
	abstract = {JSTOR is a not-for-profit service that helps scholars, researchers, and students discover, use, and build upon a wide range of content in a trusted digital archive. We use information technology and tools to increase productivity and facilitate new forms of scholarship. For more information about JSTOR, please contact support@jstor.org. The news media, a central force in today's political campaigns, can influence how citizens think about politics and how they evaluate political candidates. Although news coverage of presidential campaigns has received a great deal of study, the media's role in U.S. Senate campaigns has been largely ignored. This paper helps to close this gap by examining news coverage of 24 Senate campaigns from 1984 and 1986. The results suggest that news coverage of U.S. Senate races is far from homogeneous: certain Senate candidates, in certain states, at certain times, receive far more press attention than other candidates. Similarly, the pattern of campaign coverage in Senate races is radically dif-ferent from presidential campaign coverage. At the presidential level, the discussion of the horse race far exceeds the discussion of the candidates' policy positions. At the Sen-ate level, issues are emphasized in the news and the horse race receives far less attention.},
	number = {3},
	journal = {Legislative Studies Quarterly},
	author = {Kahn, Kim Fridkin},
	year = {1991},
	keywords = {campaigns, senate},
	pages = {349},
}

