@article{Suzuki:1991,
	title = {The {Rationality} of {Economic} {Voting} and the {Macroeconomic} {Regime}},
	volume = {35},
	issn = {00925853},
	doi = {10.2307/2111558},
	abstract = {Since voter rationality plays a major role in theories of political{\textbackslash}neconomics, it is important for political analysts to investigate{\textbackslash}nthe extent of voter sophistication. A conventional strategy for addressing{\textbackslash}nthis question is to determine what decision rule voters appear to{\textbackslash}nuse by estimating rival political support models that embody varying{\textbackslash}nassumptions about voter rationality. However, under some circumstances,{\textbackslash}nsuch a strategy may be incapable of identifying the descriptively{\textbackslash}nsuperior model due to an observational equivalence problem. The paper{\textbackslash}nestimates the competing political support models under alternative{\textbackslash}nmacroeconomic regimes and finds evidence favoring the nonrationalist{\textbackslash}nor adaptive model.},
