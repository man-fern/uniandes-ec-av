@article{Quattrone:1988,
	title = {Contrasting rational and psychological analyses of political choice},
	volume = {82},
	doi = {10.1017/CBO9780511803475.026},
	abstract = {We contrast the rational theory of choice in the form of expected utility theory with descriptive psychological analysis in the form of prospect theory, using problems involving the choice between political candidates and public referendum issues. The results showed that the assumptions underlying the classical theory of risky choice are systematically violated in the manner predicted by prospect theory. In particular, our respondents exhibited risk aversion in the domain of gains, risk seeking in the domain of losses, and a greater sensitivity to losses than to gains. This is consistent with the advantage of the incumbent under normal conditions and the potential advantage of the challenger in bad times. The results further show how a shift in the reference point could lead to reversals of preferences in the evaluation of political and economic options, contrary to the assumption of invariance. Finally, we contrast the normative and descriptive analyses of uncertainty in choice and address the rationality of voting.},
	journal = {Choices, Values, and Frames},
	author = {Quattrone, George A. and Tversky, Amos},
	year = {2019},
	note = {ISBN: 9780511803475},
	pages = {451--472},
}

@article{Carson:2010,
	title = {The electoral costs of party loyalty in congress},
	volume = {54},
	issn = {00925853},
	doi = {10.1111/j.1540-5907.2010.00449.x},
	abstract = {To what extent is party loyalty a liability for incumbent legislators? Past research on legislative voting and elections suggests that voters punish members who are ideologically "out of step" with their districts. In seeking to move beyond the emphasis in the literature on the effects of ideological extremity on legislative vote share, we examine how partisan loyalty can adversely affect legislators' electoral fortunes. Specifically, we estimate the effects of each legislator's party unity-the tendency of a member to vote with his or her party on salient issues that divide the two major parties-on vote margin when running for reelection. Our results suggest that party loyalty on divisive votes can indeed be a liability for incumbent House members. In fact, we find that voters are not punishing elected representatives for being too ideological; they are punishing them for being too partisan. ©2010, Midwest Political Science Association.},
	number = {3},
	journal = {American Journal of Political Science},
	publisher = {Wiley Online Library},
	author = {Carson, Jamie L. and Koger, Gregory and Lebo, Matthew J. and Young, Everett},
	year = {2010},
	pages = {598--616},
}

@article{Collett:1976,
	title = {The {Subjective} {Nature} of {Outlier} {Rejection} {Procedures}},
	volume = {25},
	issn = {00359254},
	url = {http://www.jstor.org/stable/2347230},
	doi = {10.2307/2347230},
	abstract = {Procedures for rejecting outliers are essentially two stage, involving{\textbackslash}nfirst an individual's judgment that a value in a given set of data{\textbackslash}nis surprising, and then testing the surprising value for discordancy.{\textbackslash}nThe conventional frequency interpretation of the significance level{\textbackslash}nfor outlier tests is shown to be invalid and an experiment designed{\textbackslash}nto investigate the inherent subjective nature of outlier procedures{\textbackslash}nis described. This confirms that there are variations both between{\textbackslash}nindividuals in their reaction to surprising values and also between{\textbackslash}njudgments made by the same individual on different occasions. The{\textbackslash}nmethod of presentation of the data is shown to affect an individual's{\textbackslash}nability to perceive possible outliers. More surprising, it turns{\textbackslash}nout that factors such as scale and pattern of the data are also very{\textbackslash}nrelevant.},
	number = {3},
	journal = {Applied Statistics},
	publisher = {Blackwell Publishing for the Royal Statistical Society},
	author = {Collett, D. and Lewis, T.},
	year = {1976},
	pages = {228},
}

@article{Traber:2014,
	title = {Party {Unity} in the {Swiss} {Parliament}: {The} {Electoral} {Connection}},
	volume = {20},
	issn = {17439337},
	doi = {10.1080/13572334.2013.837259},
	abstract = {This study investigates the connection between legislative and electoral politics in Switzerland. The authors postulate that party unity is higher in an election year, and more specifically in votes on issues that are important for the party platform and that are of greater visibility to voters. The authors analyse the entire voting record of the Swiss parliament (lower house) on legislative acts between 1996 and 2007, which consists of roll call votes as well as unpublished votes. The authors find a strong effect of elections on voting unity among certain parties, and also find encouraging support for the hypotheses that this effect is mediated by the visibility of the vote and related issue salience. © 2013 Taylor \& Francis.},
