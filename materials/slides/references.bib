	doi = {10.2307/439866},
	abstract = {Recent research by Rabinowitz and Macdonald (1989) claims that voting{\textbackslash}nbehavior is better accounted for by a directional model than by a{\textbackslash}ntraditional proximity or Euclidean model. This paper compares directional{\textbackslash}nand Euclidean models using congressional roll-call voting data. For{\textbackslash}nthese relatively well-informed voters, we can unambiguously reject{\textbackslash}nthe directional model in favor of the traditional Euclidean spatial{\textbackslash}nmodel. We conclude that congressional voting can indeed be very accurately{\textbackslash}nrepresented by the Euclidean model.},
