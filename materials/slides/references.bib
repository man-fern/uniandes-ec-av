@techreport{arango2004,
	title = {Minimum {Wages} in {Colombia}: {Holding} the {Middle} with a {Bite} {Cost} of acceptance of payment cards by merchants ({Colombia}) {View} project {The} {Minimum} {Wage} in {Colombia}: {Holding} the {Middle} with a {Bite} on the {Poor}},
	url = {https://www.researchgate.net/publication/4938420},
	abstract = {This paper exploits the long history of the minimum wage in a relatively stable developing economy like Colombia. The goals are twofold: We explore whether the minimum wage alleviates the living conditions of low income families and whether it distorts market outcomes to do so. We found significant negative minimum wage effects on both household head´s likelihood of being employed and hours worked. We also found a positive effect on the participation of non-head family members especially in families with low human capital. Finally, we found evidence that the minimum wage ends up being regressive, improving the living conditions of families in the middle and the upper part of the income distribution with non to significant net losses for those at the bottom. JEL classification:O15, J31, J42, J48.},
	author = {Arango, Carlos A and Pachon, Angelica and Pachón, Angelica},
	year = {2004},
	keywords = {Colombia, income distribution, income inequality, minimum wage, poverty},
}

