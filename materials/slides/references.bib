	year = {1996},
	keywords = {canada, elections, issues},
	pages = {327--343},
}

@article{Monroe:1981,
	title = {Presidential {Popularity}: {An} {Almon} {Distributed} {Lag} {Model}},
	volume = {7},
	issn = {01622021},
	url = {http://www.jstor.org/stable/25791103},
	abstract = {This paper will introduce the Almon estimation method of distributed lag models, widely used in econometrics, to political scientists and will demonstrate the method's usefulness and limitations. Theoretical links between the economy and presidential popularity suggest the appropriateness of the Almon model. The Almon model should detect more economic influences on popularity than the traditional models since these models are, in essence, merely special cases of the more comprehensive Almon model. Testing three models using the same monthly economic and Gallup data on popularity supports this. The Almon model does provide for a more complex economic memory and influence pattern and therefore detects economic influences--especially delayed, cumulative patterns of influence--that the other models cannot adequately detect. This empirical test, however, also underscores the Almon model's limitations. In particular, the specification of the polynomial and the length of lag period may present difficulties. Nevertheless, when used with care, the Almon estimation method of distributed lag models is a useful tool for political analysis.},
	number = {1},
	journal = {Political Methodology},
	author = {Monroe, Kristen R..},
	year = {1981},
	keywords = {⛔ No DOI found},
	pages = {43--69},
}

