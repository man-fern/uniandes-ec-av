	volume = {48},
	issn = {00129682},
	doi = {10.2307/1912017},
	abstract = {Existing strategies for econometric analysis related to macroeconomics are subject to a{\textbackslash}r{\textbackslash}n number of serious objections, some recently formulated, some old. These objections are{\textbackslash}r{\textbackslash}n summarized in this paper, and it is argued that taken together they make it unlikely that{\textbackslash}r{\textbackslash}n macroeconomic models are in fact over identified, as the existing statistical theory usually{\textbackslash}r{\textbackslash}n assumes. The implications of this conclusion are explored, and an example of econometric{\textbackslash}r{\textbackslash}n work in a non-standard style, taking account of the objections to the standard style, is{\textbackslash}r{\textbackslash}n presented},
	number = {1},
