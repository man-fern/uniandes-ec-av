@article{Mackie:1990,
	title = {On-{Line} and {Memory}-{Based} {Modification} of {Attitudes}: {Determinants} of {Message} {Recall}-{Attitude} {Change} {Correspondence}},
	volume = {59},
	issn = {00223514},
	doi = {10.1037/0022-3514.59.1.5},
	abstract = {Experiments investigated the impact of message elaboration on attitude change-message recall correspondence when attitude change occurs in an on-line (as attitude-relevant information is received), or memory-based (on the basis of retrieved attitude-relevant information) fashion. In 2 experiments, Ss' processing goals were manipulated to increase or inhibit on-line change and message elaboration. As predicted, Ss reported postexposure attitudes more rapidly in on-line vs memory-based conditions. Decreased message elaboration increased attitude-recall correspondence, regardless of when attitude change occurred. Increased elaboration produced elaboration-attitude judgment correspondence. Results suggest that recall of message content will best predict persuasion when message content is encoded free of elaborations, regardless of when attitude change occurs.},
	number = {1},
	journal = {Journal of Personality and Social Psychology},
	author = {Mackie, Diane M. and Asuncion, Arlene G.},
	year = {1990},
	pages = {5--16},
}

@article{Wichowsky:2012,
	title = {District complexity and the personal vote},
	volume = {37},
	issn = {03629805},
	doi = {10.1111/j.1939-9162.2012.00057.x},
	abstract = {Incumbents tend to win with higher margins in less ideologically constrained districts. I argue that incumbents are advantaged by this electoral landscape in part because they work harder to cultivate a personal vote. Utilizing data on earmarks, I find that despite winning with a larger margin of victory, these incumbents act much like their colleagues who narrowly escaped electoral defeat. By more accurately measuring perceptions of electoral vulnerability, we also see stronger evidence linking district marginality to distributive politics. Such incentives appear to stem not from the risks of position taking, but from the weaker party attachments among constituents. © 2012 The Comparative Legislative Research Center of The University of Iowa.},
	number = {4},
	journal = {Legislative Studies Quarterly},
	publisher = {Wiley Online Library},
	author = {Wichowsky, Amber},
	year = {2012},
	pages = {437--463},
}

