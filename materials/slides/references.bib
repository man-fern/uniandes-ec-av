@article{Poole:1993,
	title = {The {Enduring} {Nineteenth}-{Century} {Battle} for {Economic} {Regulation}: {The} {Interstate} {Commerce} {Act} {Revisited}},
	volume = {36},
	issn = {0022-2186},
	doi = {10.1086/467299},
	abstract = {Intro  "the coalitions that initiated the 'Age of economic regulation' were in large part based on long-term, broadly based    preferences ('ideologies' if one can bear the expression) concerning the economic structure of the United States.  More precisely, measures of a representatives general 'left-right' orientation should better predict his voting on a specific regulatory issue than should measures of his constituent interests on the issue."  findings   pro-regulatory coalition predominately south of Mason-Dixon line   initial votes on railroad regulation took place in absence of well-formed coalition    later slowly became mapped onto continuum   Gilligan-Marshall-Weingast (GMW) variables have greatly diminished explanatory power after inclusion of     long-term preferences     Southern Democrats (left) vs Democrats (leftish) and Republicans (right)     agrarian (top) vs. urban (bottom) Preferences on the ICA in the 49th Congress  important regional disparities in vote with South anti-railroad and East and Mid-Atlantic pro-railroad with West    generally anti-regulation  RATINGS variables explain 91-94\% variance while GMW only 73-81\%   combined explain 90-96\%  early votes less ideological Conclusion  South as the root of pro-regulatory coalition  RATINGS outperform GMW   GMW ignores long-term logrolling behavior and is thus too isolated of a test procedure     Review:  This article is a follow-up and reinterpretation of Gilligan, Weingast, and Marshall's (hereafter GMW) article on the ICA.  Poole and Rosenthal posit that "left-right" orientation was more a factor in understanding voting behavior for the ICA than the constituency interest story told by GMW.  Two key regularities are shown:  (1) the heart of the proregulation movement was the South, and (2) initial votes on railroad regulation--pre 1884--took place in the absence of well-formed coalitions and was not based on long-term preferences.  The first thing that Poole and Rosenthal do is add variables for long-term preferences to the regression run by GMW, and show that when long-term preferences are included, the effects of the GMW variables are reduced and that long-term preferences provide a more parsimonious accounting of the votes.  The authors use D-NOMINATE scores to categorize legislators.    The analysis of Poole and Rosenthal leads them to the conclusion that a broader based economic conflict between the North and the South was at least as important as any divergence of interests in shorthaul or longhaul prices.  Rather than arguing that GMW were wrong, the authors merely argue that they have a better way of explaining the voting behavior culminating in the ICA, and that adding the variables that GMW employed adds little to the analysis.  They look at regional voting on the various bills and show that various regions had very different preferences.    "The strong differences between the parties intraregion and the strong differences between regions intraparty indicate, in a straightforward and dramatic fashion, why aggregate constituency variables cannot adequately address the data." (pg. 846)  Hence the vote was not shorthaul shippers versus longhaul shippers, but rather the South versus New England.    The authors also state that they believe that determining constituency interests was difficult for legislators.  Hence the use of long-term preferences is a superior method for explaining the voting behavior (compared to GMW's explanation based on district economic interests).},
	number = {2},
	journal = {The Journal of Law and Economics},
	author = {Poole, Keith T. and Rosenthal, Howard},
	year = {1993},
	keywords = {JRN},
	pages = {837--860},
}

