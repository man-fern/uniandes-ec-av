Series Title: Lecture Notes in Computer Science
Issue: 2},
	pages = {191--218},
}

@article{Ensley:2010,
	title = {Incumbent positioning, ideological heterogeneity and mobilization in {U}.{S}. {House} elections},
	volume = {151},
	issn = {00485829},
	doi = {10.1007/s11127-010-9733-3},
	abstract = {This article examines whether the need to mobilize citizens pushes incumbents to the ideological extremes in U. S. House elections. We test whether incumbents are more ideologically extreme as the ideological heterogeneity of the district increases and if turnout increases as incumbents become more extreme. These tests combined with the observation that divergence decreases with competitiveness suggest that candidates balance the need to attract swing voters with the need to mobilize supporters. The results also suggest that the growth in elite polarization is linked to the growing ideological heterogeneity in the electorate. © 2010 Springer Science+Business Media, LLC.},
