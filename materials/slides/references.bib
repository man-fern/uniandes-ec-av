@article{Boschetal14,
	title = {The trade-offs of welfare policies in labor markets with informal jobs: {The} case of the "seguro popular" program in {Mexico}},
	volume = {6},
	issn = {1945774X},
	url = {https://ideas.repec.org/a/aea/aejpol/v6y2014i4p71-99.html},
	doi = {10.1257/pol.6.4.71},
	abstract = {In 2002, the Mexican government began an effort to improve health access to the 50 million uninsured in Mexico, a program known as Seguro Popular (SP). The SP offered virtually free health insurance to informal workers, altering the incentives to operate in the formal economy. We find that the SP program had a negative effect on the number of employers and employees formally registered in small and medium firms (up to 50 employees). Our results suggest that the positive gains of expanding health coverage should be weighed against the implications of the reallocation of labor away from the formal sector.},
