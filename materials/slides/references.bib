@article{Adams:1997b,
	title = {Condorcet {Efficiency} and the {Behavioral} {Model} of the {Vote}},
	volume = {59},
	issn = {14682508},
	doi = {10.2307/2998600},
	abstract = {The widely used plurality and plurality runoff voting systems have been criticized on the grounds that they do a poor job of selecting the Condorcet candidate—the candidate who would defeat all rivals in a series of pairwise votes—when one exists. I employ Monte Carlo methods to evaluate the plurality and runoff systems according to the Condorcet criterion, under alternative models of voting behavior derived from behavioral research. These models are specified in terms of a policy salience coefficient, which varies with the importance voters attach to policies, compared with nonpolicy motivations. The results suggest that plurality and runoff perform extremely well when large numbers of voters engage in little policy voting—precisely the conditions which behavioral researchers have argued obtain in national elections. © 1997, Southern Political Science Association. All rights reserved.},
