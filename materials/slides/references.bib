@article{Blauetal94,
	title = {Rising wage inequality and the {US} gender gap},
	volume = {84},
	issn = {00028282},
	doi = {10.2307/2117795},
	abstract = {The US labor market has recently experienced two dramatic trends: a falling male-female pay gap and a rising level of labor-market inequality. After decades of near-constancy at about 60\%, the ratio of women's to men's pay has risen steadily since the late 1970's. At the same time, there were substantial increases in overall wage inequality for both men and women. Wage inequality rose both within and between education and experience groups, and this has been interpreted as reflecting primarily higher returns to both measured and unmeasured labor-market skills. This paper addresses the connection between these two important developments. In earlier work, overall wage inequality was found to be very important in explaining international differences in the gender pay gap. The gender pay gap in the US is larger than in most of these countries. An important part of the explanation for this pattern is the high level of wage inequality, which puts an exceptionally large penalty on being below average in the wage distribution. The results suggest that the US gap would be similar to that in countries like Sweden or Australia (the countries with the smallest gaps) if the US had their level of wage inequality. -from Authors},
	number = {2},
	journal = {American Economic Review},
	author = {Blau, F. D. and Kahn, L. M.},
	year = {1994},
	pages = {23--28},
}

