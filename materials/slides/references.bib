@article{summers1989,
	title = {Some {Simple} {Economics} of {Mandated} {Benefits}},
	volume = {79},
	issn = {0002-8282},
	abstract = {In the domain of welfare economics, universal access to a good should be provided, and governments provide it directly, as with public education and old-age benefits and health benefits almost everywhere. In other cases, governments mandate that employers provide benefits to workers or that persons obtain benefits directly themselves. As a general proposition, liberals in the U.S. rank alternative strategies in the order of public provision and mandated benefits. Conservatives have exactly opposite preferences, ranking alternatives no action, mandated benefits, and then public provision. With these preference patterns, it is little wonder that governments frequently turn to mandated benefits as a tool of social policy. The article discusses some basic analytic points that need to be kept straight in considering the economics of mandated benefit proposals. Judgments about specific policy proposals must depend on particulars, but there are important differences in the efficiency and distributional consequences of standard public provision and mandated benefit programs, which have been discusses.},
