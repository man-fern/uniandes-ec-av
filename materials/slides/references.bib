@article{Attanasio2011,
	title = {Subsidizing {Vocational} {Training} for {Disadvantaged} {Youth} in {Colombia}: {Evidence} from a {Randomized} {Trial}},
	volume = {3},
	issn = {1945-7782},
	url = {https://pubs.aeaweb.org/doi/10.1257/app.3.3.188},
