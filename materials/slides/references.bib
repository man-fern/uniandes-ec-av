@book{Daganzo:1979,
	address = {New York},
	title = {Multinomial {Probit}: {The} {Theory} and its {Application} to {Demand} {Forecasting}.},
	volume = {77},
	issn = {01621459},
	doi = {10.2307/2287751},
	abstract = {This chapter discusses the statistical interpretation of predictions. In order for discrete choice models to be really useful, it is necessary to find ways of assessing the accuracy of their predictions. Inaccuracies in the forecasts have three basic sources: (1) specification errors, (2) insufficient or poor data, and (3) poor or erroneous prediction of the distribution of the attribute vector. In the analysis of the statistical interpretation of predictions, the problems were assumed solved, which left two remaining sources of inaccuracies: (1) insufficient data and (2) uncertain distribution of the attribute vector. The chapter discusses errors in the estimation of θ0 due to lack of data. It also describes the subject for very large groups of people and for both binary and multinomial models; the logic there parallels the development of confidence intervals for points on the regression line of the standard linear model. The chapter discusses prediction intervals for small groups of individual and gives a simple rule of thumb to select an adequate sample size prior to calibration, along with handling the uncertainty in the distribution of the attribute vector.},
