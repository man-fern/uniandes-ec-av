}

@article{Norpoth:1983,
	title = {Macroeconomic {Conditions} and {Fluctuations} of {Presidential} {Popularity}: {The} {Question} of {Lagged} {Effects}},
	volume = {27},
	issn = {00925853},
	doi = {10.2307/2110893},
	abstract = {Time-series studies assuming distributed lag models have demonstrated strong effects of the economy on presidential popularity. How justified are these assumptions in view of the nonstationary behavior and autocorrelation typical of economic and popularity series? Our analysis relies on Box-Jenkins (ARIMA) techniques and uses monthly observations of unemployment, inflation, and presidential approval ratings covering 1961-1980. We fail to discern the assumed lag structures. Once the nonstationary aspects of the autocorrelation manifested by the two economic series are removed, past values of those series do not appear to influence current approval ratings of presidents with any particular lag structure. Some measurement and specification problems raised by the "prewhitening" of time series are discussed, and analysis strategy modifications are proposed to answer more conclusively the question of lagged effects of the economy on presidential popularity.},
	number = {4},
	journal = {American Journal of Political Science},
	author = {Norpoth, Helmut and Yantek, Thom},
	year = {1983},
	pages = {785},
}

@book{Ragsdale:1998,
	address = {Washington, DC},
	title = {Vital statistics on the presidency},
	isbn = {978-1-4522-9991-4},
	doi = {10.4135/9781452299914},
	abstract = {Looking beyond the individual office holders to the office itself, this Fourth Edition of Vital Statistics on the Presidency covers George Washington's tenure through the 2012 election. The book's expansive view of the presidency allows readers to recognize major themes across administrations and to reach overall conclusions about the nature of the institution and its future. The illuminating data is put into context by thoughtful essays explaining key statistical patterns, making this edition an intriguing and comprehensive reference to important patterns throughout the history of the presidency.},
	publisher = {Congresional Quarterly Press},
	author = {Ragsdale, Lyn K.},
