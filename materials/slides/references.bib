	title = {A comparative study of alternative estimators for variance components models used in econometric applications},
	volume = {68},
	issn = {1537274X},
	doi = {10.1080/01621459.1973.10482427},
	abstract = {The article investigates by means of Monte Carlo experiments the performance of the ML method, the MINQUE method and several other two-step Generalized Least Squares methods in estimating the slope coefficient in a variance components model. It concludes that in models with no lagged dependent variables there is nothing much to choose among these estimators. © Taylor \& Francis Group, LLC.},
