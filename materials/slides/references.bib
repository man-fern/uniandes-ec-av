@article{Thomas:1996,
	title = {The postelection campaign: {Competing} constructions of the {Clinton} victory in 1992},
	volume = {58},
	issn = {00223816},
	doi = {10.2307/2960228},
	abstract = {This research examines the "contested character" of Bill Clinton's victory in the 1992 election through an application of Q technique and its methodology. A Q-sample comprised of pundits' reflections on the election was sorted by political scientists, journalists, and partisan activists in addition to a sampling of ordinary citizens. Results disclose four distinct versions of Clinton's victory, each with a different story to tell about the election, reasons for the outcome, and what may or may not be taken as lessons from the results. The accounts are examined in light of their distinguishing subjectivity and in relation to political and professional attributes of their proponents. A concluding discussion links these findings to subsequent difficulties with the Clinton administration's efforts to define itself while also citing issues for further research.},
	number = {2},
