@article{Minozzi:2013,
	title = {Who heeds the call of the party in congress?},
	volume = {75},
	issn = {00223816},
	doi = {10.1017/S0022381613000480},
	abstract = {When party leaders seek support, who heeds the call and who remains unswayed? The canonical error-free spatial model of voting predicts the targeting of fence-sitting moderates. In contrast, we advance a random-utility-based model of party calls, wherein legislators who benefit the most from a common party position respond to the call of party leaders. This model predicts that extremists will heed the call of the party more than moderates, even upon controlling for baseline rates of voting with the party. To test this prediction, we develop a new method to identify party-influenced votes, to generate estimates of party-free ideal points, and to examine rates of responsiveness to political parties across members in the House of Representatives between 1973 and 2006. We find that, contrary to common portrayals of party influence, those most responsive to their parties are not the chamber moderates. Rather, responsiveness is greatest for ideological extremists in both the majority and minority parties, declining significantly among more moderate members. This finding sets the stage for new theoretical and empirical work on the role of parties in Congress. © 2013 Southern Political Science Association.},
	number = {3},
	journal = {Journal of Politics},
	publisher = {Cambridge Univ Press},
	author = {Minozzi, William and Volden, Craig},
	year = {2013},
	pages = {787--802},
}

@article{Heppell:2013,
	title = {Cameron and liberal conservatism: {Attitudes} within the parliamentary conservative party and conservative ministers},
	volume = {15},
	issn = {13691481},
	doi = {10.1111/j.1467-856X.2012.00546.x},
	abstract = {Research Highlights and Abstract: This article: Contributes to the development of academic research on the internal dynamics of the Conservative Party under the leadership of David Cameron. Contributes to the development of academic research on the processes of ministerial selection within British Government. Contributes to the development of academic research on cohort effects within parties, and the analysis of comparisons and differences between different parliamentary cohorts. Contributes to the development of academic research on the constraints upon Prime Ministerial power when in coalition. This article identifies the ideological composition of the parliamentary Conservative party (PCP) in order to determine the location and numeric strength of the critics of Cameron. By constructing a data set of attitudes across two ideological divides-the social, sexual and morality divide and the European divide-the article identifies the following. First, despite Cameron's social liberal emphasis both the PCP and his ministerial team is predominantly Thatcherite-i.e. socially conservative. Second, despite numerically having a Eurosceptic PCP and ministerial team, with Europhilia now an inconsequential rump, Cameron faces a minority 'hard' Eurosceptic faction of rebels who oppose his 'soft' Euroscepticism. Third, the influx of new parliamentarians elected in 2010 may increase social liberal strength, but they are overwhelmingly Eurosceptic, with a significant tranche of hard Eurosceptics amongst them. Finally, through a process of ideological mapping of these two ideological divides the research identifies a core of 50 socially conservative and hard Eurosceptics who are the critics of Cameron. © 2012 Political Studies Association.},
	number = {3},
	journal = {British Journal of Politics and International Relations},
	publisher = {Wiley Online Library},
	author = {Heppell, Timothy},
	year = {2013},
	keywords = {Conservative party, David Cameron, Liberal Conservatism, Ministerial, Selection, Thatcherism},
	pages = {340--361},
}

@incollection{Erikson:2001,
	address = {Washington, D.C.},
	title = {Voters, {Candidates}, and {Issues} in {Congressional} {Elections}},
	volume = {7},
	abstract = {Erikson and Wright argue that constituencies get represented adequately because the ideological make-up of the districts match that of those they elect.  They argue that national forces such as the electorate's desire for a new policy direction can influence the outcome of congressional elections as it did with the Republican take-over in 1994.  There was in fact a growing conservative policy sentiment at this time.  But they also contend that other forces separate from policy sentiment such as presidential coattails and midterm slump can also explain election outcomes.  In the end they conclude that  elections bring about a much higher level of policy responsiveness than one would expect given the low levels of political and candidate awareness.  Changes in the partisan composition of the House are the result of a small fraction of the electorate switching party vote as a result of party identification, mood, performance and president.  Erickson and Wright - "Voters Candidates and Elections"  - Understanding House voting as both a national and local perspective.  National Mood (Stimson) is important.  When mood is liberal, Democrats do better as in 1960's.  (71)  There are elements of ideology shifting in partisan voting shifts.  73-77 But it can be other things such as:    a. Coattail effect - Same mood in both Congress and Presidential elections?  Lessening in recent times.    b. Midterm Loss for Pres. Party - Why?     (1) Coattails Retraction - President inflates vote and midterm the inflated vote retracts do that they lose seats.     (2) Ideological Balancing - Moderates change votes to balance President's influence.     2. Personal Impact Important    a. Incumbent Success?  79-80         (1) District Partisanship - The favored candidate of the dominant party is going to win.  78     (2) Electoral (natural) selection - The incumbent has earned his or her place at the ballot box.  They are a top candidate.     (3) Weak Challengers - Good candidates do not want to expend funds and efforts against strong incumbents.     (4) Strategic Retirements - When there is an eminent loss, incumbents will retire rather than lose.       (5) Incumbency Advantage - Incumbents exploit the advantage of being in office and its resources.  Frank/Travel  - Pork and policy interests of district.  82    b. Individual Ideological Movement     (1) Dowsian Argument that official will move his policies to the center of the ideological distribution of his or her district.      (a) Some balancing with core or extreme beliefs of core followers.    c. How about the Senate     (1) Some of the same forces, but Senate responds more slowly to public shifts because only 1/3 elected at a time.       (2) Races much closer, and less incumbent security (75percent as compared to 95 percent in House).      (a) Why - State wide constituencies are rarely dominated by one party.       (b) Interestingly, as in the House - Senators from weaker state party tend to be atypical in ideology from the rest of their party (nationally).},
	booktitle = {Congress {Reconsidered}},
	publisher = {Congresional Quarterly Press},
	author = {Erikson, Robert S and Wright, Gerald C},
	editor = {Dodd, Lawrence C and Oppenheimer, Bruce I},
	year = {1997},
	keywords = {Candidate Positioning;},
