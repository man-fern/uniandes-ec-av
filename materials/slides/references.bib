@article{DaRocha2006,
	title = {{WHY} {ARE} {FERTILITY} {RATES} {AND} {FEMALE} {EMPLOYMENT} {RATIOS} {POSITIVELY} {CORRELATED} {ACROSS} {O}.{E}.{C}.{D}. {COUNTRIES}?},
