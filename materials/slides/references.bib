@article{EliasEtAl17,
	title = {Economic {Development} and the {Regulation} of {Morally} {Contentious} {Activities}},
	volume = {107},
	issn = {00028282},
	url = {https://ideas.repec.org/a/aea/aecrev/v107y2017i5p76-80.html},
	doi = {10.1257/aer.p20171098},
	abstract = {The regulation of many activities depends on whether societies consider them morally controversial or \&quot;repugnant.\&quot; Not only have regulation and related ethical concerns changed over time, but there is also heterogeneity across countries at a given time. We provide evidence of this heterogeneity for three morally contentious activities, abortion, prostitution, and gestational surrogacy, and explore the relationship between a country's economic conditions and how these activities are regulated. We propose a conceptual framework to identify mechanisms that can explain our findings (including the role of non-economic factors), and indicate directions for future research.},
