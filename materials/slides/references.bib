@article{Goldfield:1986,
	title = {Labor in {American} {Politics}—{Its} {Current} {Weakness}},
	volume = {48},
	issn = {14682508},
	doi = {10.2307/2130922},
	abstract = {Trade unions play an important role in United States politics. Much of their influence is based on the resources they are able to mobilize, both financially and numerically through campaign workers and votes; ultimately this influence is rooted in their membership size. Thus, their declining numerical strength over recent years has been a point of interest for many investigators. Research presented here casts doubt on several of the most commonly argued hypotheses purporting to explain this phenomena: (1) the move of population and industry from the “frostbelt” to the supposedly more union-resistant “sunbelt”*; (2) the contraction of the work force in smokestack industries; (3) the dwindling percentage of U.S. workers in the traditionally pro-union, blue-collar occupations. A more likely hypothesis is suggested—the changing relation of class forces—with certain key aspects (the employer offensive and the union response) pinpointed, examined, tested, and discussed. © 1986, Southern Political Science Association. All rights reserved.},
