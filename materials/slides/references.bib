
@article{breza2021,
	title = {Measuring the {Equilibrium} {Impacts} of {Credit}: {Evidence} from the {Indian} {Microfinance} {Crisis}},
	volume = {136},
	issn = {0033-5533},
	shorttitle = {Measuring the {Equilibrium} {Impacts} of {Credit}},
	url = {https://doi.org/10.1093/qje/qjab016},
	doi = {10.1093/qje/qjab016},
	abstract = {In October 2010, the state government of Andhra Pradesh, India, issued an emergency ordinance, bringing microfinance activities in the state to a complete halt and causing a nationwide shock to the liquidity of lenders, especially those with loans in the affected state. We use this massive dislocation in the microfinance market to identify the causal impacts of a reduction in credit supply on consumption, earnings, and employment in general equilibrium in rural labor markets. Using a proprietary district-level data set from 25 separate, for-profit microlenders matched with household data from the National Sample Survey, we find that district-level reductions in credit supply are associated with significant decreases in casual daily wages, household wage earnings, and consumption. We find a substantial consumption multiplier from credit that is likely driven by two channels—aggregate demand and business investment. We calibrate a simple two-period, two-sector model of the rural economy that incorporates both channels and show that the magnitude of our wage results is consistent with the model’s predictions.},
	number = {3},
	urldate = {2026-07-14},
	journal = {The Quarterly Journal of Economics},
	author = {Breza, Emily and Kinnan, Cynthia},
	month = aug,
	year = {2021},
	pages = {1447--1497},
}

@article{b2024,
	title = {Occupation {Growth}, {Skill} {Prices}, and {Wage} {Inequality}},
	volume = {42},
	url = {https://www.journals.uchicago.edu/doi/abs/10.1086/722084},
	doi = {10.1086/722084},
	abstract = {We study the relationship among occupational employment, occupational wages, and wage inequality. In all occupations, entrants and leavers earn less than stayers, suggesting negative selection effects for growing occupations and positive effects for shrinking ones. We estimate a model of occupational prices and skills that includes specific skill accumulation and endogenous switching. Contrary to uncorrected wages, prices and employment growth are positively related. Forty percent of selection is due to age, as entrants and leavers have had less time to accumulate skills. The remainder is Roy-type selection. Skill prices establish a quantitative connection of occupational changes with surging wage inequality.},
	number = {1},
	urldate = {2026-07-14},
	journal = {Journal of Labor Economics},
	publisher = {The University of Chicago Press},
	author = {Böhm, Michael J. and von, Gaudecker Hans-Martin and Schran, Felix},
	month = jan,
	year = {2024},
	pages = {201--243},
}

@article{baker2018,
	title = {Gender-{Based} {Occupational} {Segregation} and {Sex} {Differences} in {Sensory}, {Motor}, and {Spatial} {Aptitudes}},
	volume = {55},
	issn = {1533-7790},
	url = {https://doi.org/10.1007/s13524-018-0706-3},
	doi = {10.1007/s13524-018-0706-3},
	abstract = {Research on sex differences in humans documents gender differences in sensory, motor, and spatial aptitudes. These aptitudes, as captured by Dictionary of Occupational Titles (DOT) codes, predict the occupational choices of men and women in the directions indicated by this research. We simulate that eliminating selection on these skills reduces the Duncan index of gender-based occupational segregation by 20 \% to 23 \% in 1970 and 2012, respectively. Eliminating selection on DOT variables capturing other accounts of this segregation has a smaller impact.},
	language = {en},
	number = {5},
	urldate = {2026-07-14},
	journal = {Demography},
	author = {Baker, Michael and Cornelson, Kirsten},
	month = oct,
	year = {2018},
	keywords = {Gender, Occupational segregation, Skill differences},
	pages = {1749--1775},
}

@article{cici2021,
	title = {\#{MeToo} meets the mutual fund industry: productivity effects of sexual harassment},
	volume = {40},
	issn = {1544-6123},
	shorttitle = {\#{MeToo} meets the mutual fund industry},
	url = {https://www.sciencedirect.com/science/article/pii/S154461232030444X},
	doi = {10.1016/j.frl.2020.101687},
	abstract = {Sexual harassment, a widespread problem in the workplace, keeps female employees from optimally employing their human capital. We show that removing or diminishing this friction improves productivity. Specifically, using the male-dominated fund industry as our testing ground, we show that productivity of female mutual fund managers significantly increased after the Harvey Weinstein scandal and the onset of the \#MeToo movement. Evidence from lawsuits and organizational changes at several fund companies also suggests that reducing the threat of sexual harassment improves productivity. Our results have important implications for the policy debate on workforce diversity and costs of sexual harassment.},
	urldate = {2026-07-14},
	journal = {Finance Research Letters},
	author = {Cici, Gjergji and Hendriock, Mario and Jaspersen, Stefan and Kempf, Alexander},
	month = may,
	year = {2021},
	keywords = {Fund performance, Gender discrimination, Human capital, Organizational frictions, Sexual harassment},
	pages = {101687},
}

@article{morchio2026,
	title = {The {Gender} {Pay} {Gap}: {Micro} {Sources} and {Macro} {Consequences}},
	volume = {116},
	issn = {0002-8282},
	shorttitle = {The {Gender} {Pay} {Gap}},
	url = {https://www.aeaweb.org/articles?id=10.1257/aer.20231107},
	doi = {10.1257/aer.20231107},
	abstract = {Using linked employer-employee data from Brazil, we document a significant gender pay gap, which is largely attributed to women working at lower-paying employers. To interpret this fact, we develop an equilibrium search model with endogenous firm pay, amenities, and hiring. We provide a constructive proof of identification of all model parameters. The estimated model suggests that amenities are important for both men and women, and that compensating differentials account for half of the gender pay gap. Equal treatment policies partly close gender gaps but are not output- or welfare-improving.},
	language = {en},
	number = {5},
	urldate = {2026-07-14},
	journal = {American Economic Review},
	author = {Morchio, Iacopo and Moser, Christian},
	month = may,
	year = {2026},
	keywords = {Aggregate Human Capital, Aggregate Labor Productivity, Economics of Gender, Economic Development: Human Resources; Human Development; Income Distribution; Migration, Economics of Gender; Non-labor Discrimination, Employment, Employment; Unemployment; Wages; Intergenerational Income Distribution; Aggregate Human Capital; Aggregate Labor Productivity, Human Development, Income Distribution, Intergenerational Income Distribution, Labor Demand, Migration, Non-labor Discrimination, Labor Demand, Wage Level and Structure, Nonwage Labor Costs and Benefits; Retirement Plans; Private Pensions, Personnel Economics: Firm Employment Decisions; Promotions, Private Pensions, Personnel Economics: Firm Employment Decisions, Promotions, Economic Development: Human Resources, Retirement Plans, Unemployment, Wage Differentials, Nonwage Labor Costs and Benefits, Wage Level and Structure; Wage Differentials, Wages},
	pages = {1765--1810},
}

