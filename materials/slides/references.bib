@article{harding2014,
	title = {What {Democracy} {Does} (and {Doesn}’t {Do}) for {Basic} {Services}: {School} {Fees}, {School} {Inputs}, and {African} {Elections}},
	volume = {76},
	issn = {0022-3816},
	shorttitle = {What {Democracy} {Does} (and {Doesn}’t {Do}) for {Basic} {Services}},
	url = {https://www.journals.uchicago.edu/doi/abs/10.1017/s0022381613001254},
	doi = {10.1017/S0022381613001254},
	abstract = {Does democracy affect the provision of basic services? We advance on existing empirical work on this subject by exploring the potential mechanisms through which a democratic transition may prompt a government to alter provision of basic services to its citizens. In an environment of weak state capacity, in which it is difficult for voters to attribute outcomes to executive actions, we suggest that electoral competition is most likely to lead to changes in policies where executive action is verifiable. Considering the context of African primary education as an example, we suggest that electoral competition will therefore give governments an incentive to abolish school fees, but it will have less effect on the provision of school inputs, precisely because executive actions on these issues are more difficult to monitor. We evaluate this claim by approaching it in three different ways, using cross-national as well as individual-level data, including an original data set on primary school fee abolitions. First we show that in Africa, democracies have higher rates of school attendance than nondemocracies. Moreover, evidence suggests that this is primarily due to the fact that democracies are more likely to abolish school fees, not to the fact that they provide more inputs. We then estimate the likelihood that a government will abolish school fees subsequent to an election, taking account of endogeneity concerns involving election timing. Finally, we use survey data from Kenya to provide evidence suggesting that citizens condition their voting intentions on an outcome that a politician can control directly, in this case abolishing school fees, but not on outcomes over which politicians have much more indirect influence, such as local school quality.},
	number = {1},
	urldate = {2026-01-28},
	journal = {The Journal of Politics},
	publisher = {The University of Chicago Press},
	author = {Harding, Robin and Stasavage, David},
	month = jan,
	year = {2014},
	pages = {229--245},
}

@article{mani2007,
	series = {Papers from a {Symposium}: {The} {Social} {Dimensions} of {Microeconomic} {Behaviour} in {Low}-{Income} {Communities}},
	title = {Democracy, visibility and public good provision},
	volume = {83},
	issn = {0304-3878},
	url = {https://www.sciencedirect.com/science/article/pii/S0304387806000642},
	doi = {10.1016/j.jdeveco.2005.06.008},
	abstract = {We examine the role of visibility in influencing government resource allocation across a multiplicity of public goods. We show that a “visibility effect” distorts governmental resource allocation such that it helps explain why governments neglect provision of essential public goods, despite their considerable benefits. We show that greater democratization widens the gap in resource allocation between more visible (such as famine prevention) versus less visible (such as malnutrition prevention) public goods, up to an intermediate level of democracy. Beyond this level, this gap decreases. Furthermore, public goods with low visibility are prone to multiple equilibria in resource allocation, with voter expectations being shown to be important.},
	number = {2},
	urldate = {2026-01-28},
	journal = {Journal of Development Economics},
	author = {Mani, Anandi and Mukand, Sharun},
	month = jul,
	year = {2007},
	keywords = {Democracy, Famines, Government responsiveness, Public goods, Visibility, Voter expectations},
	pages = {506--529},
}

@article{heldring2025,
	title = {The {Origins} of {Government} and the {State}},
	volume = {17},
	issn = {1941-1383, 1941-1391},
	url = {https://www.annualreviews.org/content/journals/10.1146/annurev-economics-081224-064327},
	doi = {10.1146/annurev-economics-081224-064327},
	abstract = {In recent years, a vibrant literature has emerged that studies the first states in history, both as substantive topic of interest and as an important input into understanding modern government. This survey article presents, structures, and discusses recent advances in the theoretical and empirical study in the economics of the origins of government and the state. The core hypotheses in this literature view the nature of government as extractive or cooperative. I discuss how this fundamental dichotomy in the view of the state has influenced its study and review empirical contributions. The fundamental dichotomy is not resolved, leaving room for further research.},
