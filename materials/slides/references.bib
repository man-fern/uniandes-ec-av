@article{Lustig13,
	title = {Declining {Inequality} in {Latin} {America} in the 2000s: {The} {Cases} of {Argentina}, {Brazil}, and {Mexico}},
	volume = {44},
	issn = {0305750X},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0305750X12002276},
