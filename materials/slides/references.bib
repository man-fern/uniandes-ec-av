@article{Atkin2009,
	title = {Working for the {Future}: {Female} {Factory} {Work} and {Child} {Health} in {Mexico}},
	abstract = {In this paper, I show that the women induced to work in export manufacturing by the opening of a new factory nearby have significantly taller children. This increased child height does not come through higher household income alone, with these women reporting stronger bargaining power within their households. Since women who choose to work in factories may be quite different from those who do not, I require an instrument that increases the probability of working in a factory but does not affect child height directly. Therefore, I instrument for whether a woman’s first job was in export manufacturing with factory openings in her town at the legal employment age of 16. I use a LATE estimator to find that women induced to enter manufacturing by the opening of a factory have children who are over one standard deviation taller. This group of women, whose lives are altered by the factory, are exactly the group that concerns a local policymaker deciding industrial policy.},
