@article{King:1988,
	title = {Statistical {Models} for {Political} {Science} {Event} {Counts}: {Bias} in {Conventional} {Procedures} and {Evidence} for the {Exponential} {Poisson} {Regression} {Model}},
	volume = {32},
	issn = {00925853},
	doi = {10.2307/2111248},
	abstract = {This paper presents analytical, Monte Carlo, and empirical evidence on models for event count data. Event counts are dependent variables that measure the number of times some event occurs. Counts of international events are probably the most common, but numerous examples exist in every empirical field of the discipline. The results of the analysis below strongly suggest that the way event counts have been analyzed in hundreds of important political science studies have produced statisti- cally and substantively unreliable results. Misspecification, inefficiency, bias, inconsistency, insuffi- ciency, and other problems result from the unknowing application of two common methods that are without theoretical justification or empirical utility in this type of data. I show that the exponential Poisson regression (EPR) model provides analytically, in large samples, and empirically, in small, finite samples, a far superior model and optimal estimator. I also demonstrate the advantage of this methodology in an application to nineteenth-century party switching in the U.S. Congress. Its use by political scientists is strongly encouraged. 1.},
	number = {3},
	journal = {American Journal of Political Science},
	author = {King, Gary},
	year = {1988},
	keywords = {econometrics, poisson},
	pages = {838},
}

@article{Erikson:1998,
	title = {What {Moves} {Macropartisanship}? {A} {Response} to {Green}, {Palmquist}, and {Schickler}},
	volume = {92},
	issn = {0003-0554},
	doi = {10.2307/2586311},
	abstract = {Contrary to the claim by Green, Palmquist, and Schickler (1998), macropartisanship is largely shaped by presidential approval and consumer sentiment. It is not the case, however, that macropartisanship mirrors the ever-changing levels of current presidential popularity and prosperity. Rather, macropartisanship reflects the cumulation of political and economic news that shapes approval and consumer sentiment. Using ECM technology, we show that, far from being the weak force that Green et al. suggest, the cumulation of innovations in presidential approval and consumer sentiment largely account for the long-term trends in macropartisanship. For forecasting macropartisanship in the near future, it is better to predict from the fundamentals represented by the history of approval and consumer sentiment up to a given moment than from current values of macropartisanship itself.},
	number = {4},
	journal = {American Political Science Review},
	author = {Erikson, Robert S. and Mackuen, Michael B. and Stimson, James A.},
	year = {1998},
	pages = {901--912},
}

