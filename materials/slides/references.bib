@article{Lodge:1995a,
	title = {The {Responsive} {Voter}: {Campaign} {Information} and the {Dynamics} of {Candidate} {Evaluation}},
	volume = {89},
	issn = {0003-0554},
	doi = {10.2307/2082427},
	abstract = {We find strong support for an on-line model of the candidate evaluation process that in contrast to memory-based models shows that citizens are responsive to campaign information, adjusting their overall evaluation of the candidates in response to their immediate assessment of campaign messages and events. Over time people forget most of the campaign information they are exposed to but are nonetheless able to later recollect their summary affective evaluation of candidates which they then use to inform their preferences and vote choice. These findings have substantive, methodological, and normative implications for the study of electoral behavior. Substantively, we show how campaign information affects voting behavior. Methodologically, we demonstrate the need to measure directly what campaign information people actually attend to over the course of a campaign and show that after controling for the individual's on-line assessment of campaign messages, National Election Study-type recall measures prove to be spurious as explanatory variables. Finally, we draw normative implications for democratic theory of on-line processing, concluding that citizens appear to be far more responsive to campaign messages than conventional recall models suggest.},
	number = {2},
	journal = {American Political Science Review},
	author = {Lodge, Milton and Steenbergen, Marco R. and Brau, Shawn},
	year = {1995},
	pages = {309--326},
}

@book{Clasen:2005,
	title = {Reforming {European} {Welfare} {States}: {Germany} and the {United} {Kingdom} {Compared}},
	isbn = {978-0-19-160326-6},
	doi = {10.1093/0199270716.001.0001},
	abstract = {The book investigates the processes of welfare state reform in the UK and Germany between the late 1970s and 2003. Adopting a programme-level perspective, it systematically compares processes of retrenchment, expansion and restructuring in three core social policy domains. The book suggests that unemployment support and public pension programmes have been subjected to retrenchment and restructuring, while family policies have been extended in both countries. However, patterns of retrenchment and restructuring differ across countries and programmes. Arguing in favour of multi-causal explanations of reform processes and outcomes, the book stresses the relevance of three sets of explanatory factors: shifts in party policy preferences and power relations, three institutional variables and contingent factors impinging on policy direction and profiles. Within pension policy, the relevance of different institutional characteristics and the respective balance between private and public forms of retirement suggest that the concept of 'path dependence' is particularly instructive. By contrast, differences in programme structures and their role within national political economies prove to be most relevant for the understanding of changes in unemployment support policy. Less institutionally embedded and expanding, the trajectories of family policies have to be seen in the context of dynamic party policy preferences.},
	publisher = {Oxford University Press},
	author = {Clasen, Jochen},
	year = {2006},
	note = {Publication Title: Reforming European Welfare States: Germany and the United Kingdom Compared},
	keywords = {Comparative analysis, European welfare states, Family policy, Germany, Labour market policy, Pension policy, Social policy, UK, Unemployment policy, Welfare reform},
}

@article{Miller:2003,
	title = {Activists and partisan realignment in the {United} {States}},
	volume = {97},
	issn = {00030554},
	doi = {10.1017/S0003055403000650},
	abstract = {In this paper, we contend that party realignments occur due to the interaction of candidates and activists. We examine independent party candidates who are motivated primarily to win elections but who use activist contributions to increase vote shares. In a two-dimensional policy space, such candidates will on occasion engage in "flanking" moves so as to enlist coalitions of disaffected voters, at the risk of alienating some of their traditional activist supporters. We argue that a result of such "flanking" moves, in the early part of the century, has been a shift in emphasis from an underlying social dimension to the economic dimension. In recent decades, electoral salience has shifted back to the social dimension. The net result is that the party cleavage line is much as it was a century ago - but the parties have switched sides.},
	number = {2},
	journal = {American Political Science Review},
	author = {Miller, Gary and Schofield, Norman},
	year = {2003},
	pages = {245--260},
}

@article{Squire:1990,
	title = {Fundraising by {Nonincumbent} {Candidates} for the {U}. {S}. {House} of {Representatives}},
	volume = {15},
	issn = {03629805},
	doi = {10.2307/440003},
	abstract = {Accessed: 29-01-2018 16:01 UTC JSTOR is a not-for-profit service that helps scholars, researchers, and students discover, use, and build upon a wide range of content in a trusted digital archive. We use information technology and tools to increase productivity and facilitate new forms of scholarship. For more information about JSTOR, please contact support@jstor.org. The amount of money raised by nonincumbent candidates is a critical variable for explaining congressional election outcomes. Why are some nonincumbent candidates for the U.S. House of Representatives able to raise more campaign money than others? We propose that candidates who represent large state legislative districts are able to raise more campaign funds than candidates who represent small districts or candidates who are not state representatives at all. This hypothesis is supported by analysis of data from the 1980, 1982, and 1984 congressional elections. Few nonincumbent candidates for the U.S. House of Represen-tatives run successful campaigns, but those who do generally raise and spend a great deal of money. In the 1980 and 1982 elections, winning challengers spent an average of two to three times more than losing chal-lengers (Jacobson 1987, 137), and victorious open-seat candidates raised more money, on average, than incumbents (Ornstein, Mann, and Malbin 1987, 72-73). Because challengers and candidates for open seats are generally less well known than incumbents, an abundant sup-ply of money is crucial for establishing and maintaining positive con-tacts with voters. Given the importance of money to congressional candidates in general, and to nonincumbents in particular, we think it is important to investigate why some candidates raise more money than others. Our purpose in this paper is to propose and to test one hypothesis for suc-cessful fundraising by nonincumbent candidates for the U.S. House of Representatives. We propose that candidates with experience repre-senting large state legislative districts are more successful at raising money, other things being equal, than candidates with experience rep-resenting small districts or candidates with no state legislative experi-ence at all.},
	number = {1},
	journal = {Legislative Studies Quarterly},
	author = {Squire, Peverill and Wright, John R.},
	year = {1990},
	keywords = {congress, elections, spending},
	pages = {89},
}

